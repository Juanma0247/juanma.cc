---
import MainLayout from './MainLayout.astro'
import tools from '../data/tools.json'

interface Props {
  slug: string
  title?: string
  description?: string
  titleHref?: string
  i18nExtra?: { ns: string; en: Record<string, unknown>; es: Record<string, unknown> }
}

const { slug, title, description, titleHref = '/projects', i18nExtra } = Astro.props

const tool = tools.find(t => t.slug === slug)
if (!tool) throw new Error(`Tool not found: "${slug}"`)
---

<MainLayout
  title={title ?? tool.pageTitle}
  navTitle={tool.navTitle}
  section="Tools"
  titleHref={titleHref}
  description={description}
  i18nExtra={i18nExtra}
>
  <slot name="head" slot="head" />
  <div class="page-shell">
    <slot />
  </div>
</MainLayout>

<style is:global>@import '../styles/sections/tools.css';</style>
