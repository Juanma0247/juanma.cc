---
import Navbar from '../components/Navbar.astro'
import { en } from '../data/i18n/en'
import { es } from '../data/i18n/es'
import { cld } from '../lib/core/cld'

export interface Props {
  title?: string
  navTitle?: string
  section?: string
  titleKey?: string
  description?: string
  titleHref?: string
}

const SITE_URL = 'https://juanma.cc'
const DEFAULT_DESCRIPTION =
  'Portafolio de Juan Manuel Díaz, científico en computación y desarrollador full stack. Proyectos, herramientas interactivas y experimentos de código, matemáticas, hobbies y diseño en constante evolución.'

const {
  title,
  navTitle,
  section = '',
  titleKey = '',
  description = DEFAULT_DESCRIPTION,
  titleHref = '',
} = Astro.props

const resolvedNavTitle = navTitle || title || 'Juanma'
const pageTitle = title || 'Juanma'
const ogTitle = title ? `${title} · Juanma` : 'Juan Manuel Díaz — Proyectos & Herramientas'
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href
// Social crawlers need an absolute URL: use the Cloudinary URL when configured,
// otherwise fall back to the absolute local path.
const ogResolved = cld('/img/og-image.png')
const ogImage = ogResolved.startsWith('http') ? ogResolved : `${SITE_URL}${ogResolved}`
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n={titleKey || undefined}>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      ;(function () {
        // Kiosk redirect before paint (web lock, 1h TTL). Authorized accounts exempt.
        try {
          var web = JSON.parse(localStorage.getItem('site-web') || 'null')
          if (!web || !web.lock || !web.lock.appliedAt || !web.lock.path) return
          var active = (Date.now() - web.lock.appliedAt < 60 * 60 * 1000)
            && localStorage.getItem('site-is-admin') !== '1'
          if (active && window.location.pathname !== web.lock.path) {
            window.location.replace(web.lock.path)
          }
        } catch (e) {}
      })()
    </script>
    <script is:inline>
      ;(function () {
        var path = window.location.pathname
        if (path !== '/') localStorage.setItem('site-last-page', path)

        if (path === '/' && !sessionStorage.getItem('landing-done')) {
          var lastPage = localStorage.getItem('site-last-page')
          var cached   = localStorage.getItem('site-default-landing')
          if (lastPage && lastPage !== '/') {
            sessionStorage.setItem('landing-done', '1')
            window.location.replace(lastPage)
            return
          }
          if (cached && cached !== '/') {
            sessionStorage.setItem('landing-done', '1')
            window.location.replace(cached)
            return
          }
        }
      })()
    </script>
    <script is:inline>
      ;(function () {
        // Effective settings before paint, under priority web (3) > user (2) > system (1).
        function parse(s) { try { return JSON.parse(s) } catch (e) { return null } }
        var FONT_MAP = {
          inter:      { stack: "'Inter', sans-serif",        url: 'Inter:wght@400;700' },
          roboto:     { stack: "'Roboto', sans-serif",       url: 'Roboto:wght@400;700' },
          playfair:   { stack: "'Playfair Display', serif",  url: 'Playfair+Display:wght@400;700' },
          montserrat: { stack: "'Montserrat', sans-serif",   url: 'Montserrat:wght@400;700' },
          'fira-code':{ stack: "'Fira Code', monospace",     url: 'Fira+Code:wght@400;700' },
        }
        var web = parse(localStorage.getItem('site-web'))
        var b = null
        if (web && web.broadcast && web.broadcast.appliedAt &&
            Date.now() - web.broadcast.appliedAt < 4 * 60 * 60 * 1000 &&
            String(web.broadcast.appliedAt) !== localStorage.getItem('site-web-optout')) {
          b = web.broadcast
        }
        var r = document.documentElement

        var userTheme = localStorage.getItem('site-theme')
        if (userTheme === 'seted') { userTheme = 'customizable'; localStorage.setItem('site-theme', 'customizable') }
        var theme = (b && b.theme != null) ? b.theme : (userTheme || 'system')
        r.dataset.theme = theme
        if (theme === 'customizable') {
          var c = (b && b.theme === 'customizable' && b.customColors)
            ? b.customColors : parse(localStorage.getItem('site-theme-custom'))
          if (c) {
            r.style.setProperty('--color-primary', c.primary)
            r.style.setProperty('--color-text',    c.text)
            r.style.setProperty('--color-bg',      c.bg)
            r.style.setProperty('--color-muted',   c.muted)
          }
        }

        var font = (b && b.font != null) ? b.font : localStorage.getItem('site-font')
        if (font && FONT_MAP[font]) {
          var lnk = document.createElement('link')
          lnk.id   = 'gfont-link'
          lnk.rel  = 'stylesheet'
          lnk.href = 'https://fonts.googleapis.com/css2?family=' + FONT_MAP[font].url + '&display=swap'
          document.head.appendChild(lnk)
          r.style.setProperty('--font-ui',   FONT_MAP[font].stack)
          r.style.setProperty('--font-bold', FONT_MAP[font].stack)
        }
      })()
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Juanma" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Juan Manuel Díaz — Desarrollador Web" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#008888" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" integrity="sha384-wcIxkf4k558AjM3Yz3BBFQUbk/zgIYC2R0QpeeYb+TwlBVMrlgLqwRjRtGZiK7ww" crossorigin="anonymous" />

    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js" integrity="sha384-hIoBPJpTUs74ddyc4bFZSM1TVlQDA60VBbJS0oA934VSz82sBx1X7kSx2ATBDIyd" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js" integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk" crossorigin="anonymous" onload="renderMathInElement(document.body)"></script>
    <script defer src="https://unpkg.com/feather-icons"></script>

    <slot name="head" />
  </head>
  <body>
    <div id="page-loader" aria-hidden="true" data-label={resolvedNavTitle}>
      <div class="loader__inner">
        <span class="loader__name" data-i18n={titleKey || undefined}>{resolvedNavTitle}</span>
        <div class="loader__dots">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>

    <svg id="ocean" class="background"></svg>

    <Navbar
      navTitle={resolvedNavTitle}
      section={section}
      titleHref={titleHref}
      titleKey={titleKey}
    />

    <main class="contenedor">
      <slot />
    </main>

    <script is:inline define:vars={{ loaderI18nKey: titleKey }}>
      window.__loaderI18nKey = loaderI18nKey || null
    </script>

    <script>
      import Background from '../lib/core/Background.js'
      import * as S from '../lib/core/settings.js'

      Background.main()
      // @ts-ignore
      if (typeof feather !== 'undefined') feather.replace()
      // @ts-ignore
      else window.addEventListener('load', () => feather?.replace())

      document.addEventListener('click', e => {
        const btn = (e.target as Element).closest<HTMLElement>('.spin [data-step]')
        if (!btn) return
        const input = btn.closest('.number-wrap')?.querySelector<HTMLInputElement>('input')
        if (!input) return
        input[btn.dataset.step === 'up' ? 'stepUp' : 'stepDown']()
        input.dispatchEvent(new Event('input', { bubbles: true }))
      })

      // Reusable loader API for projects, games, tools, etc.
      ;(window as any).PageLoader = {
        show(label?: string) {
          let el = document.getElementById('page-loader') as HTMLElement | null
          const resolveLabel = () => {
            if (label) return label
            const key = (window as any).__loaderI18nKey as string | null
            if (key) {
              const lang = localStorage.getItem('site-lang') ?? 'en'
              const get = (o: any, p: string) => p.split('.').reduce((a: any, k: string) => a?.[k], o)
              const val = get((window as any).__i18n?.[lang], key)
              if (val) return val as string
            }
            return el?.dataset.label ?? 'Juanma'
          }
          const name = resolveLabel()
          if (!el) {
            el = document.createElement('div')
            el.id = 'page-loader'
            el.setAttribute('aria-hidden', 'true')
            el.innerHTML = `<div class="loader__inner"><span class="loader__name">${name}</span><div class="loader__dots"><span></span><span></span><span></span></div></div>`
            document.body.prepend(el)
          } else {
            const nameEl = el.querySelector<HTMLElement>('.loader__name')
            if (nameEl) nameEl.textContent = name
            el.classList.remove('loader--hidden')
          }
        },
        hide() {
          const el = document.getElementById('page-loader') as HTMLElement | null
          if (!el || el.classList.contains('loader--hidden')) return
          el.classList.add('loader--hidden')
          el.addEventListener('transitionend', () => el.remove(), { once: true })
        },
      }

      // Effective settings were already applied synchronously before paint, so the
      // loader can be revealed quickly; the web listener refines in real time.
      function hideLoader() {
        ;(window as any).PageLoader?.hide()
      }

      const MIN_MS = 350
      const start  = Date.now()
      const quickHide = () => setTimeout(hideLoader, Math.max(0, MIN_MS - (Date.now() - start)))
      if (document.readyState === 'complete') quickHide()
      else window.addEventListener('load', quickHide, { once: true })
      setTimeout(hideLoader, 6000)

      // ── Real-time web settings + kiosk lock ─────────────────────────────────
      function lockMessages() {
        const lang = localStorage.getItem('site-lang') || S.detectSystemLang()
        const t = (window as any).__i18n?.[lang] ?? (window as any).__i18n?.en
        const k = t?.kiosk ?? {}
        return {
          text:      k.restricted ?? 'Restricted by site settings.',
          remaining: k.remaining ?? 'Time remaining',
          ok:        k.gotIt ?? 'OK',
        }
      }

      let lastWeb: any = S.readWeb()
      function refresh() {
        if (S.applyKiosk(lastWeb, lockMessages())) return
        S.reapply()
      }
      refresh()
      S.listenWeb((web: any) => { lastWeb = web; refresh() })

      // ── Auth: admin flag, per-account settings, last-page sync ───────────────
      // Only relevant to the site owner signing in — deferred past `load` and
      // onto an idle slice so anonymous visitors don't pay for the Firebase
      // Auth bundle during the initial page load.
      function initAuth() {
        ;(async () => {
          try {
            const auth = await import('../lib/core/Auth.js')
            auth.onAuthChange(async (user: any) => {
              if (!user) {
                localStorage.removeItem(S.LS.admin)
                refresh()
                return
              }
              if (auth.isAuthorized(user.email)) localStorage.setItem(S.LS.admin, '1')
              else localStorage.removeItem(S.LS.admin)
              try {
                const us: any = await S.getUserSettings(user.uid)
                if (us) {
                  if (us.theme)        localStorage.setItem(S.LS.theme, us.theme)
                  if (us.customColors) localStorage.setItem(S.LS.custom, JSON.stringify(us.customColors))
                  if (us.font)         localStorage.setItem(S.LS.font, us.font)
                  if (us.lang)         localStorage.setItem(S.LS.lang, us.lang)
                }
              } catch (e) {}
              refresh()
              const lp = localStorage.getItem(S.LS.lastPage)
              if (lp) S.saveUserSettings(user.uid, { lastPage: lp }).catch(() => {})
            })
          } catch (e) {
            console.error('MainLayout: auth unavailable', e)
          }
        })()
      }

      function scheduleAuth() {
        const w = window as any
        if (typeof w.requestIdleCallback === 'function') w.requestIdleCallback(initAuth, { timeout: 2000 })
        else setTimeout(initAuth, 200)
      }

      if (document.readyState === 'complete') scheduleAuth()
      else window.addEventListener('load', scheduleAuth, { once: true })
    </script>

    <script is:inline define:vars={{ i18nEn: en, i18nEs: es }}>
      ;(function () {
        const TRANSLATIONS = { en: i18nEn, es: i18nEs }
        const LANG_KEY = 'site-lang'

        const get = (obj, path) => path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj)

        const applyLang = (lang, persist = true) => {
          const t = TRANSLATIONS[lang] ?? TRANSLATIONS.en

          document.querySelectorAll('[data-i18n]').forEach(el => {
            const val = get(t, el.getAttribute('data-i18n'))
            if (val == null) return
            if (el.tagName === 'TITLE') { document.title = val; return }
            if (val.includes('<')) el.innerHTML = val
            else el.textContent = val
          })

          document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
            const val = get(t, el.getAttribute('data-i18n-placeholder'))
            if (val != null) el.placeholder = val
          })

          document.querySelectorAll('[data-i18n-title]').forEach(el => {
            const val = get(t, el.getAttribute('data-i18n-title'))
            if (val != null) el.title = val
          })

          document.querySelectorAll('[data-i18n-aria-label]').forEach(el => {
            const val = get(t, el.getAttribute('data-i18n-aria-label'))
            if (val != null) el.setAttribute('aria-label', val)
          })

          if (persist) localStorage.setItem(LANG_KEY, lang)
          document.documentElement.lang = lang
          window.__lang = lang
          window.dispatchEvent(new CustomEvent('langchanged', { detail: lang }))
        }

        window.__i18n = TRANSLATIONS
        window.applyLang = applyLang

        // Static content that embeds LaTeX (data-i18n prose/labels) is swapped as
        // raw text on a language change; re-run KaTeX so it renders again.
        window.addEventListener('langchanged', function () {
          if (window.renderMathInElement) window.renderMathInElement(document.body)
        })

        // Bridge for runtime-generated content (project/game/tool JS). Resolves a
        // dotted key against the current language, falling back to a supplied
        // default (usually the English source string) so nothing ever breaks.
        window.i18nGet = (key, fallback) => {
          const l = window.__lang || 'en'
          const val = get(TRANSLATIONS[l] ?? TRANSLATIONS.en, key)
          return val == null ? (fallback != null ? fallback : key) : val
        }

        // Effective language: web (3) > user (2) > system (1). Do not persist,
        // so a resolved value never overwrites the user's own choice.
        function parse(s) { try { return JSON.parse(s) } catch (e) { return null } }
        var web = parse(localStorage.getItem('site-web'))
        var b = null
        if (web && web.broadcast && web.broadcast.appliedAt &&
            Date.now() - web.broadcast.appliedAt < 4 * 60 * 60 * 1000 &&
            String(web.broadcast.appliedAt) !== localStorage.getItem('site-web-optout')) {
          b = web.broadcast
        }
        var userLang = localStorage.getItem(LANG_KEY)
        var sys = (navigator.language || 'en').toLowerCase().indexOf('es') === 0 ? 'es' : 'en'
        var lang = (b && b.lang != null) ? b.lang : (userLang || sys)
        applyLang(lang, false)
      })()
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/reset.css';
  @import '../styles/typography.css';
  @import '../styles/forms.css';
  @import '../styles/global.css';
  @import '../styles/navbar.css';

  .contenedor {
    position: relative;
    z-index: 0;
    padding-top: 1rem;
    min-height: calc(100vh - 3.375rem);
  }

  /* Shared horizontal gutter for Projects/Tools/Games pages — see ProjectLayout,
     ToolLayout and GameLayout. Individual pages should not add their own side
     padding/max-width; use .page-shell--wide (per-slug) to opt out instead. */
  .page-shell {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-shell--wide {
    max-width: none;
  }

  /* ── Page Loader ─────────────────────────────────────────────────────────── */

  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }

  #page-loader.loader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .loader__name {
    font-family: var(--font-bold);
    font-size: 2.5rem;
    color: var(--color-primary);
    opacity: 0;
    animation: loader-appear 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .loader__dots {
    display: flex;
    gap: 0.6rem;
  }

  .loader__dots span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-primary);
    animation: loader-pulse 1.4s ease infinite;
  }

  .loader__dots span:nth-child(2) { animation-delay: 0.2s; }
  .loader__dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes loader-appear {
    from { opacity: 0; transform: translateY(0.6rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes loader-pulse {
    0%, 60%, 100% { opacity: 0.2; transform: scale(0.85); }
    30%            { opacity: 1;   transform: scale(1.3);  }
  }
</style>
