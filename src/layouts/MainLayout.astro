---
export interface Props {
  title?: string
  section?: string
  extraHead?: string
}

const { title = 'Juanma', section = '' } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Juanma` : 'Juanma'}</title>
    <link rel="icon" href="/img/favicon.svg" />
    <meta name="description" content="Sitio web oficial de Juan Manuel Diaz Gomez. Descubre mi trabajo, proyectos y contacto." />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" integrity="sha384-wcIxkf4k558AjM3Yz3BBFQUbk/zgIYC2R0QpeeYb+TwlBVMrlgLqwRjRtGZiK7ww" crossorigin="anonymous" />

    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js" integrity="sha384-hIoBPJpTUs74ddyc4bFZSM1TVlQDA60VBbJS0oA934VSz82sBx1X7kSx2ATBDIyd" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js" integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk" crossorigin="anonymous" onload="renderMathInElement(document.body)"></script>
    <script src="https://www.geogebra.org/apps/deployggb.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jstat@1.9.6/dist/jstat.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>

    <slot name="head" />
  </head>
  <body>
    <svg id="ocean" class="background"></svg>

    <header class="header">
      <label id="menuButtonMain">
        <input type="checkbox" />
        <svg id="menuBottonClickerMain" class="menuBottonClicker" viewBox="0 0 32 32">
          <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
          <path class="line" d="M7 16 27 16"></path>
        </svg>
      </label>

      <nav class="navbar">
        <ul class="navbar__menu">
          <li class="navbar__item">
            <a href="/" class="navbar__link"><i data-feather="home"></i><span>Home</span></a>
          </li>
          <li class="navbar__item">
            <a href="/projects" class="navbar__link"><i data-feather="folder"></i><span>Projects</span></a>
          </li>
          <li class="navbar__item">
            <a href="/tools" class="navbar__link"><i data-feather="tool"></i><span>Tools</span></a>
          </li>
          <li class="navbar__item">
            <a href="/scripts" class="navbar__link"><i data-feather="code"></i><span>Scripts</span></a>
          </li>
          <li class="navbar__item">
            <a href="/contact" class="navbar__link"><i data-feather="message-circle"></i><span>Contact</span></a>
          </li>
          <li class="navbar__item">
            <a href="/games" class="navbar__link"><i data-feather="pie-chart"></i><span>Games</span></a>
          </li>
        </ul>
      </nav>

      <h1 class="titulo" onclick="window.location='/'">Juanma</h1>

      <div class="center spamTop">
        <img class="icoSpamTop" src="/img/favicon.svg" />
        <p class="titleSpamTop">jm-247.web.app</p>
      </div>
    </header>

    <main class="contenedor">
      <slot />
    </main>

    <script>
      import Background from '../lib/core/Background.js'
      Background.main()
      // @ts-ignore
      feather.replace()
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/menu.css';

  .contenedor {
    position: relative;
    z-index: 0;
    padding-top: 1rem;
    min-height: calc(100vh - 3rem);
  }
</style>