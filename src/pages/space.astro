---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="Space" section="Space" titleKey="space.title">
  <div class="space-page">

    <div class="space-page__grid">

      <!-- Page Settings (auth) -->
      <section class="settings-card settings-card--auth" id="settings-page">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.34 1.804A1 1 0 0 1 9.32 1h1.36a1 1 0 0 1 .98.804l.295 1.473c.497.144.971.342 1.416.587l1.25-.834a1 1 0 0 1 1.262.125l.962.962a1 1 0 0 1 .125 1.262l-.834 1.25c.245.445.443.919.587 1.416l1.473.294a1 1 0 0 1 .804.98v1.361a1 1 0 0 1-.804.98l-1.473.295a6.95 6.95 0 0 1-.587 1.416l.834 1.25a1 1 0 0 1-.125 1.262l-.962.962a1 1 0 0 1-1.262.125l-1.25-.834a6.953 6.953 0 0 1-1.416.587l-.294 1.473a1 1 0 0 1-.98.804H9.32a1 1 0 0 1-.98-.804l-.295-1.473a6.957 6.957 0 0 1-1.416-.587l-1.25.834a1 1 0 0 1-1.262-.125l-.962-.962a1 1 0 0 1-.125-1.262l.834-1.25a6.957 6.957 0 0 1-.587-1.416l-1.473-.294A1 1 0 0 1 1 10.68V9.32a1 1 0 0 1 .804-.98l1.473-.295c.144-.497.342-.971.587-1.416l-.834-1.25a1 1 0 0 1 .125-1.262l.962-.962A1 1 0 0 1 5.38 2.93l1.25.834a6.957 6.957 0 0 1 1.416-.587L8.34 1.804ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="settings.page.title">Page Settings</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.page.desc">Customize site behavior. Requires an authorized account.</p>

        <div id="page-state-signedout">
          <button class="settings-google-btn" id="page-signin-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84Z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"/>
            </svg>
            <span data-i18n="settings.page.signIn">Sign in with Google</span>
          </button>
        </div>

        <div id="page-state-unauthorized" hidden>
          <p class="page-auth-error" data-i18n="settings.page.unauthorized">This account is not authorized.</p>
          <button class="settings-signout-btn" id="page-signout-btn-unauth">
            <span data-i18n="settings.page.signOut">Sign out</span>
          </button>
        </div>

        <div id="page-state-authorized" hidden>
          <div class="page-user-row">
            <img class="page-user-avatar" id="page-user-avatar" src="" alt="" />
            <div class="page-user-info">
              <span class="page-user-name" id="page-user-name"></span>
              <button class="settings-signout-btn" id="page-signout-btn">
                <span data-i18n="settings.page.signOut">Sign out</span>
              </button>
            </div>
          </div>
          <div class="page-setting-row">
            <label class="page-setting-label" for="page-default-landing" data-i18n="settings.page.defaultLanding">Default landing page</label>
            <select class="page-setting-select" id="page-default-landing"></select>
            <p class="page-save-feedback" id="page-save-feedback" hidden></p>
          </div>
        </div>
      </section>

      <!-- Web variables (broadcast, authorized only) -->
      <section class="settings-card" id="space-web" hidden>
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.5 2A2.5 2.5 0 0 0 2 4.5v11A2.5 2.5 0 0 0 4.5 18h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 15.5 2h-11ZM10 5a5 5 0 0 0-5 5 .75.75 0 0 0 1.5 0A3.5 3.5 0 0 1 10 6.5a.75.75 0 0 0 0-1.5Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="space.web.title">Web variables (live)</h3>
        </div>
        <p class="settings-card__desc" data-i18n="space.web.desc">Applied in real time to everyone on the site for 4 hours.</p>

        <div class="space-field">
          <label class="page-setting-label" for="web-theme" data-i18n="space.web.theme">Theme</label>
          <select class="page-setting-select" id="web-theme">
            <option value="" data-i18n="space.web.none">— No change</option>
            <option value="system" data-i18n="settings.theme.system">System</option>
            <option value="light" data-i18n="settings.theme.light">Light</option>
            <option value="dark" data-i18n="settings.theme.dark">Dark</option>
            <option value="customizable" data-i18n="settings.theme.custom">Custom</option>
          </select>
        </div>

        <div class="settings-theme__custom" id="web-theme-custom" hidden>
          <div class="settings-custom__warnings" id="web-cp-warnings"></div>
          <div class="settings-custom__colors">
            <label class="settings-custom__item">
              <input type="color" id="web-cp-primary" value="#008888" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorPrimary">Primary</span>
              <span class="settings-custom__hex" id="web-cp-primary-hex">#008888</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="web-cp-text" value="#000000" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorText">Text</span>
              <span class="settings-custom__hex" id="web-cp-text-hex">#000000</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="web-cp-bg" value="#ffffff" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorBg">Background</span>
              <span class="settings-custom__hex" id="web-cp-bg-hex">#ffffff</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="web-cp-muted" value="#888888" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorMuted">Muted</span>
              <span class="settings-custom__hex" id="web-cp-muted-hex">#888888</span>
            </label>
          </div>
          <div class="cp-preview" id="web-cp-preview">
            <p class="cp-preview__label" data-i18n="settings.theme.previewLabel">Preview</p>
            <div class="cp-preview__page">
              <div class="cp-preview__topbar">
                <span class="cp-preview__brand">Juanma</span>
                <span class="cp-preview__navlink">Home</span>
                <span class="cp-preview__navlink cp-preview__navlink--active">About</span>
                <span class="cp-preview__navlink">Projects</span>
              </div>
              <div class="cp-preview__content">
                <h4 class="cp-preview__title" data-i18n="settings.theme.previewSection">Section title</h4>
                <p class="cp-preview__body">
                  <span data-i18n="settings.theme.previewBody">Body text content.</span>
                  <span class="cp-preview__muted" data-i18n="settings.theme.previewMuted">Secondary info.</span>
                </p>
                <div class="cp-preview__row">
                  <span class="cp-preview__btn">Button</span>
                  <span class="cp-preview__link">Link</span>
                </div>
              </div>
            </div>
          </div>
          <div class="settings-custom__presets">
            <span class="settings-custom__presets-label">Presets</span>
            <div class="settings-custom__presets-list">
              <button class="settings-custom__preset" data-preset="grayscale" data-i18n="settings.theme.presets.grayscale">Grayscale</button>
              <button class="settings-custom__preset" data-preset="pastels" data-i18n="settings.theme.presets.pastels">Pastels</button>
              <button class="settings-custom__preset" data-preset="warm" data-i18n="settings.theme.presets.warm">Warm</button>
              <button class="settings-custom__preset" data-preset="vintage" data-i18n="settings.theme.presets.vintage">Vintage</button>
              <button class="settings-custom__preset" data-preset="neon" data-i18n="settings.theme.presets.neon">Neon</button>
            </div>
          </div>
        </div>
        <div class="space-field">
          <label class="page-setting-label" for="web-font" data-i18n="space.web.font">Font</label>
          <select class="page-setting-select" id="web-font">
            <option value="" data-i18n="space.web.none">— No change</option>
            <option value="__default" data-i18n="settings.font.default">Default</option>
            <option value="inter">Inter</option>
            <option value="roboto">Roboto</option>
            <option value="playfair">Playfair Display</option>
            <option value="montserrat">Montserrat</option>
            <option value="fira-code">Fira Code</option>
          </select>
        </div>
        <div class="space-field">
          <label class="page-setting-label" for="web-lang" data-i18n="space.web.lang">Language</label>
          <select class="page-setting-select" id="web-lang">
            <option value="" data-i18n="space.web.none">— No change</option>
            <option value="en">English</option>
            <option value="es">Español</option>
          </select>
        </div>

        <div class="space-status" id="web-status" hidden>
          <span class="space-status__dot"></span>
          <span data-i18n="space.web.active">Applying to everyone</span>
          <span class="space-status__timer" id="web-status-timer"></span>
        </div>

        <div class="settings-custom__actions">
          <button class="settings-custom__cancel" id="web-clear" data-i18n="space.web.remove">Remove</button>
          <button class="settings-custom__apply" id="web-apply" data-i18n="space.web.apply">Apply to the web</button>
        </div>
      </section>

      <!-- Kiosk lock (authorized only) -->
      <section class="settings-card" id="space-kiosk" hidden>
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="space.kiosk.title">Restrict to a page</h3>
        </div>
        <p class="settings-card__desc" data-i18n="space.kiosk.desc">Sends every visitor to one page and blocks navigation for 1 hour. You (authorized) are exempt.</p>

        <div class="space-field">
          <label class="page-setting-label" for="kiosk-dest" data-i18n="space.kiosk.destination">Destination page</label>
          <select class="page-setting-select" id="kiosk-dest"></select>
        </div>

        <div class="space-status space-status--warn" id="kiosk-status" hidden>
          <span class="space-status__dot"></span>
          <span data-i18n="space.kiosk.active">Restriction active</span>
          <span class="space-status__timer" id="kiosk-status-timer"></span>
        </div>

        <div class="settings-custom__actions">
          <button class="settings-custom__cancel" id="kiosk-release" data-i18n="space.kiosk.release">Release</button>
          <button class="settings-custom__apply" id="kiosk-activate" data-i18n="space.kiosk.activate">Restrict now</button>
        </div>
      </section>

    </div>
  </div>
</MainLayout>

<style>
  .space-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .space-page__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    align-content: start;
  }

  .space-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .space-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui), sans-serif;
    font-size: 0.78rem;
    color: var(--color-text);
  }

  .space-status__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
  }

  .space-status--warn .space-status__dot { background: #b3261e; }

  .space-status__timer {
    font-family: JetBrainsMono, monospace;
    font-weight: bold;
    color: var(--color-primary);
    background: var(--primary-15);
    border-radius: 2rem;
    padding: 0.1rem 0.55rem;
    margin-left: auto;
  }

  .space-status--warn .space-status__timer {
    color: #b3261e;
    background: color-mix(in srgb, #b3261e 15%, transparent);
  }

  @media (max-width: 40rem) {
    .space-page__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { DESTINATIONS } from '../data/destinations'
  import * as S from '../lib/core/settings.js'

  function getMsg(key: string): string {
    const lang = localStorage.getItem('site-lang') || S.detectSystemLang()
    const t = (window as any).__i18n?.[lang] ?? (window as any).__i18n?.en
    return key.split('.').reduce((o: any, k: string) => o?.[k], t) ?? key
  }

  const stateSignedout    = document.getElementById('page-state-signedout')    as HTMLElement
  const stateUnauthorized = document.getElementById('page-state-unauthorized') as HTMLElement
  const stateAuthorized   = document.getElementById('page-state-authorized')   as HTMLElement
  const userAvatar        = document.getElementById('page-user-avatar')        as HTMLImageElement
  const userName          = document.getElementById('page-user-name')          as HTMLElement
  const landingSelect     = document.getElementById('page-default-landing')    as HTMLSelectElement
  const saveFeedback      = document.getElementById('page-save-feedback')      as HTMLElement

  const adminCards = [
    document.getElementById('space-web')   as HTMLElement,
    document.getElementById('space-kiosk') as HTMLElement,
  ]

  // Populate destination selects (landing + kiosk) from the shared list.
  function fillDestinations(select: HTMLSelectElement) {
    const groups: Record<string, HTMLOptGroupElement> = {}
    for (const dest of DESTINATIONS) {
      if (!groups[dest.group]) {
        const og = document.createElement('optgroup')
        og.label = dest.group
        groups[dest.group] = og
        select.appendChild(og)
      }
      const opt = document.createElement('option')
      opt.value = dest.value
      opt.textContent = dest.label
      groups[dest.group].appendChild(opt)
    }
  }
  const kioskDest = document.getElementById('kiosk-dest') as HTMLSelectElement
  fillDestinations(landingSelect)
  fillDestinations(kioskDest)

  function showAuthState(state: 'signedout' | 'unauthorized' | 'authorized') {
    stateSignedout.hidden    = state !== 'signedout'
    stateUnauthorized.hidden = state !== 'unauthorized'
    stateAuthorized.hidden   = state !== 'authorized'
    adminCards.forEach(c => { c.hidden = state !== 'authorized' })
  }

  let saveFeedbackTimer: ReturnType<typeof setTimeout> | null = null
  function flashFeedback(ok: boolean) {
    saveFeedback.textContent = getMsg(ok ? 'settings.page.saved' : 'settings.page.errorSaving')
    saveFeedback.dataset.state = ok ? 'ok' : 'error'
    saveFeedback.hidden = false
    if (saveFeedbackTimer) clearTimeout(saveFeedbackTimer)
    saveFeedbackTimer = setTimeout(() => { saveFeedback.hidden = true }, 2500)
  }

  // ── Web broadcast controls ────────────────────────────────────────────────────

  const webTheme  = document.getElementById('web-theme') as HTMLSelectElement
  const webFont   = document.getElementById('web-font')  as HTMLSelectElement
  const webLang   = document.getElementById('web-lang')  as HTMLSelectElement
  const webStatus = document.getElementById('web-status') as HTMLElement
  const webTimer  = document.getElementById('web-status-timer') as HTMLElement
  let webTimerId: ReturnType<typeof setInterval> | null = null

  // ── Custom color picker (broadcast a custom theme, like accessibility) ──────────

  const CP_DEFAULTS = { primary: '#008888', text: '#000000', bg: '#ffffff', muted: '#888888' }
  const CP_PRESETS: Record<string, typeof CP_DEFAULTS> = {
    grayscale: { primary: '#555555', text: '#111111', bg: '#f5f5f5', muted: '#888888' },
    pastels:   { primary: '#6b9fae', text: '#2c4a52', bg: '#f0fafc', muted: '#8fb0bc' },
    warm:      { primary: '#c07840', text: '#2a1a00', bg: '#fdf4e8', muted: '#a07850' },
    vintage:   { primary: '#8b6914', text: '#2c1a00', bg: '#f5ecd7', muted: '#9a8050' },
    neon:      { primary: '#00ff88', text: '#ccffee', bg: '#001a0e', muted: '#00bb66' },
  }

  function relativeLuminance(hex: string): number {
    const n = parseInt(hex.replace('#', ''), 16)
    return [((n >> 16) & 255), ((n >> 8) & 255), (n & 255)]
      .map(c => { const s = c / 255; return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4) })
      .reduce((acc, c, i) => acc + c * [0.2126, 0.7152, 0.0722][i], 0)
  }
  function contrastRatio(a: string, b: string): number {
    const la = relativeLuminance(a), lb = relativeLuminance(b)
    return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)
  }

  const cpPanel   = document.getElementById('web-theme-custom') as HTMLElement
  const cpPrimary = document.getElementById('web-cp-primary') as HTMLInputElement
  const cpText    = document.getElementById('web-cp-text')    as HTMLInputElement
  const cpBg      = document.getElementById('web-cp-bg')      as HTMLInputElement
  const cpMuted   = document.getElementById('web-cp-muted')   as HTMLInputElement
  const cpWarn    = document.getElementById('web-cp-warnings') as HTMLElement
  const cpPreview = document.getElementById('web-cp-preview')  as HTMLElement
  const hexPrimary = document.getElementById('web-cp-primary-hex') as HTMLElement
  const hexText    = document.getElementById('web-cp-text-hex')    as HTMLElement
  const hexBg      = document.getElementById('web-cp-bg-hex')      as HTMLElement
  const hexMuted   = document.getElementById('web-cp-muted-hex')   as HTMLElement

  function syncCpPicker() {
    hexPrimary.textContent = cpPrimary.value
    hexText.textContent    = cpText.value
    hexBg.textContent      = cpBg.value
    hexMuted.textContent   = cpMuted.value
    cpPreview.style.setProperty('--pv-primary', cpPrimary.value)
    cpPreview.style.setProperty('--pv-text',    cpText.value)
    cpPreview.style.setProperty('--pv-bg',      cpBg.value)
    cpPreview.style.setProperty('--pv-muted',   cpMuted.value)
    const checks = [
      { msg: getMsg('settings.theme.warnTextBg'),      a: cpText.value,    b: cpBg.value,      min: 4.5 },
      { msg: getMsg('settings.theme.warnPrimaryBg'),   a: cpPrimary.value, b: cpBg.value,      min: 3.0 },
      { msg: getMsg('settings.theme.warnTextPrimary'), a: cpText.value,    b: cpPrimary.value, min: 4.5 },
    ]
    cpWarn.innerHTML = checks
      .filter(({ a, b, min }) => contrastRatio(a, b) < min)
      .map(({ msg }) => `<span class="cp-warning--bad">⚠ ${msg}</span>`).join('')
  }

  function loadCpPicker(colors: typeof CP_DEFAULTS) {
    cpPrimary.value = colors.primary
    cpText.value    = colors.text
    cpBg.value      = colors.bg
    cpMuted.value   = colors.muted
    syncCpPicker()
  }

  function toggleCpPanel() {
    cpPanel.hidden = webTheme.value !== 'customizable'
  }

  webTheme.addEventListener('change', () => {
    toggleCpPanel()
    if (webTheme.value === 'customizable') loadCpPicker(CP_DEFAULTS)
  })
  ;[cpPrimary, cpText, cpBg, cpMuted].forEach(el => el.addEventListener('input', syncCpPicker))
  document.querySelectorAll<HTMLButtonElement>('#web-theme-custom .settings-custom__preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = CP_PRESETS[btn.dataset.preset!]
      if (p) loadCpPicker(p)
    })
  })

  document.getElementById('web-apply')!.addEventListener('click', async () => {
    const fields: Record<string, any> = {}
    if (webTheme.value === 'customizable') {
      fields.theme = 'customizable'
      fields.customColors = { primary: cpPrimary.value, text: cpText.value, bg: cpBg.value, muted: cpMuted.value }
    } else if (webTheme.value) {
      fields.theme = webTheme.value
    }
    if (webFont.value)  fields.font  = webFont.value === '__default' ? '' : webFont.value
    if (webLang.value)  fields.lang  = webLang.value
    try {
      if (Object.keys(fields).length === 0) await S.clearBroadcast()
      else await S.saveBroadcast(fields)
    } catch { /* rules / offline */ }
  })

  document.getElementById('web-clear')!.addEventListener('click', () => {
    S.clearBroadcast().catch(() => {})
  })

  // ── Kiosk controls ────────────────────────────────────────────────────────────

  const kioskStatus = document.getElementById('kiosk-status') as HTMLElement
  const kioskTimer  = document.getElementById('kiosk-status-timer') as HTMLElement
  let kioskTimerId: ReturnType<typeof setInterval> | null = null

  document.getElementById('kiosk-activate')!.addEventListener('click', () => {
    S.saveLock(kioskDest.value).catch(() => {})
  })
  document.getElementById('kiosk-release')!.addEventListener('click', () => {
    S.clearLock().catch(() => {})
  })

  // ── Live status / countdowns ──────────────────────────────────────────────────

  function renderWeb(web: any) {
    // Broadcast status + countdown
    const bActive = S.broadcastActive(web)
    webStatus.hidden = !bActive
    if (webTimerId) { clearInterval(webTimerId); webTimerId = null }
    if (bActive) {
      const appliedAt = web.broadcast.appliedAt
      const b = web.broadcast
      webTheme.value = b.theme ?? ''
      if (b.theme === 'customizable' && b.customColors) loadCpPicker(b.customColors)
      toggleCpPanel()
      webFont.value  = b.font === '' ? '__default' : (b.font ?? '')
      webLang.value  = b.lang ?? ''
      const tick = () => {
        const remaining = appliedAt + S.BROADCAST_TTL - Date.now()
        webTimer.textContent = S.fmtCountdown(remaining)
        if (remaining <= 0 && webTimerId) { clearInterval(webTimerId); webTimerId = null; webStatus.hidden = true }
      }
      tick(); webTimerId = setInterval(tick, 1000)
    }

    // Kiosk status + countdown
    const lActive = S.lockActive(web)
    kioskStatus.hidden = !lActive
    if (kioskTimerId) { clearInterval(kioskTimerId); kioskTimerId = null }
    if (lActive) {
      if (web.lock.path) kioskDest.value = web.lock.path
      const appliedAt = web.lock.appliedAt
      const tick = () => {
        const remaining = appliedAt + S.LOCK_TTL - Date.now()
        kioskTimer.textContent = S.fmtCountdown(remaining)
        if (remaining <= 0 && kioskTimerId) { clearInterval(kioskTimerId); kioskTimerId = null; kioskStatus.hidden = true }
      }
      tick(); kioskTimerId = setInterval(tick, 1000)
    }

    if (web && web.defaultLanding) landingSelect.value = web.defaultLanding
  }

  // ── Auth + wiring ─────────────────────────────────────────────────────────────

  ;(async () => {
    let auth: any
    try {
      auth = await import('../lib/core/Auth.js')
    } catch (e) {
      console.error('Space: cloud/auth unavailable:', e)
      return
    }

    const { signIn, signOut, onAuthChange, isAuthorized } = auth

    function handleSignOut() { signOut().catch(console.error) }
    document.getElementById('page-signin-btn')!.addEventListener('click', () => {
      signIn().catch(console.error)
    })
    document.getElementById('page-signout-btn')!.addEventListener('click', handleSignOut)
    document.getElementById('page-signout-btn-unauth')!.addEventListener('click', handleSignOut)

    onAuthChange(async (user: any) => {
      if (!user) { showAuthState('signedout'); return }
      if (!isAuthorized(user.email)) {
        showAuthState('unauthorized')
        await signOut()
        return
      }
      userAvatar.src = user.photoURL || ''
      userName.textContent = user.displayName || user.email || ''
      showAuthState('authorized')
      const web = await S.getWeb()
      renderWeb(web)
    })

    landingSelect.addEventListener('change', async () => {
      try { await S.saveLanding(landingSelect.value); flashFeedback(true) }
      catch { flashFeedback(false) }
    })

    // Keep statuses live for the admin while the page is open.
    S.listenWeb((web: any) => renderWeb(web))
  })()
</script>
