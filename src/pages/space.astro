---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="Space" section="Space" titleKey="space.title">
  <div class="space-page">

    <div class="space-page__grid">

      <!-- Page Settings -->
      <section class="settings-card settings-card--auth" id="settings-page">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.34 1.804A1 1 0 0 1 9.32 1h1.36a1 1 0 0 1 .98.804l.295 1.473c.497.144.971.342 1.416.587l1.25-.834a1 1 0 0 1 1.262.125l.962.962a1 1 0 0 1 .125 1.262l-.834 1.25c.245.445.443.919.587 1.416l1.473.294a1 1 0 0 1 .804.98v1.361a1 1 0 0 1-.804.98l-1.473.295a6.95 6.95 0 0 1-.587 1.416l.834 1.25a1 1 0 0 1-.125 1.262l-.962.962a1 1 0 0 1-1.262.125l-1.25-.834a6.953 6.953 0 0 1-1.416.587l-.294 1.473a1 1 0 0 1-.98.804H9.32a1 1 0 0 1-.98-.804l-.295-1.473a6.957 6.957 0 0 1-1.416-.587l-1.25.834a1 1 0 0 1-1.262-.125l-.962-.962a1 1 0 0 1-.125-1.262l.834-1.25a6.957 6.957 0 0 1-.587-1.416l-1.473-.294A1 1 0 0 1 1 10.68V9.32a1 1 0 0 1 .804-.98l1.473-.295c.144-.497.342-.971.587-1.416l-.834-1.25a1 1 0 0 1 .125-1.262l.962-.962A1 1 0 0 1 5.38 2.93l1.25.834a6.957 6.957 0 0 1 1.416-.587L8.34 1.804ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="settings.page.title">Page Settings</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.page.desc">Customize site behavior. Requires an authorized account.</p>

        <div id="page-state-signedout">
          <button class="settings-google-btn" id="page-signin-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84Z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"/>
            </svg>
            <span data-i18n="settings.page.signIn">Sign in with Google</span>
          </button>
        </div>

        <div id="page-state-unauthorized" hidden>
          <p class="page-auth-error" data-i18n="settings.page.unauthorized">This account is not authorized.</p>
          <button class="settings-signout-btn" id="page-signout-btn-unauth">
            <span data-i18n="settings.page.signOut">Sign out</span>
          </button>
        </div>

        <div id="page-state-authorized" hidden>
          <div class="page-user-row">
            <img class="page-user-avatar" id="page-user-avatar" src="" alt="" />
            <div class="page-user-info">
              <span class="page-user-name" id="page-user-name"></span>
              <button class="settings-signout-btn" id="page-signout-btn">
                <span data-i18n="settings.page.signOut">Sign out</span>
              </button>
            </div>
          </div>
          <div class="page-setting-row">
            <label class="page-setting-label" for="page-default-landing" data-i18n="settings.page.defaultLanding">Default landing page</label>
            <select class="page-setting-select" id="page-default-landing"></select>
            <p class="page-save-feedback" id="page-save-feedback" hidden></p>
          </div>
        </div>
      </section>

    </div>
  </div>
</MainLayout>

<style>
  .space-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .space-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
</style>

<script>
  import { DESTINATIONS } from '../data/destinations'

  function getMsg(key: string): string {
    const lang = localStorage.getItem('site-lang') || 'en'
    const t = (window as any).__i18n?.[lang] ?? (window as any).__i18n?.en
    return key.split('.').reduce((o: any, k: string) => o?.[k], t) ?? key
  }

  const stateSignedout    = document.getElementById('page-state-signedout')    as HTMLElement
  const stateUnauthorized = document.getElementById('page-state-unauthorized') as HTMLElement
  const stateAuthorized   = document.getElementById('page-state-authorized')   as HTMLElement
  const userAvatar        = document.getElementById('page-user-avatar')        as HTMLImageElement
  const userName          = document.getElementById('page-user-name')          as HTMLElement
  const landingSelect     = document.getElementById('page-default-landing')    as HTMLSelectElement
  const saveFeedback      = document.getElementById('page-save-feedback')      as HTMLElement

  const groups: Record<string, HTMLOptGroupElement> = {}
  for (const dest of DESTINATIONS) {
    if (!groups[dest.group]) {
      const og = document.createElement('optgroup')
      og.label = dest.group
      groups[dest.group] = og
      landingSelect.appendChild(og)
    }
    const opt = document.createElement('option')
    opt.value = dest.value
    opt.textContent = dest.label
    groups[dest.group].appendChild(opt)
  }

  function showAuthState(state: 'signedout' | 'unauthorized' | 'authorized') {
    stateSignedout.hidden    = state !== 'signedout'
    stateUnauthorized.hidden = state !== 'unauthorized'
    stateAuthorized.hidden   = state !== 'authorized'
  }

  let saveFeedbackTimer: ReturnType<typeof setTimeout> | null = null

  // Load Firebase auth + cloud settings lazily. If it fails (offline or a stale
  // dev bundle), the page still renders — only cloud features are unavailable.
  ;(async () => {
    let auth, saveSettings, getSettings
    try {
      auth = await import('../lib/core/Auth.js')
      const ss = await import('../lib/core/SiteSettings.js')
      saveSettings = ss.saveSettings
      getSettings  = ss.getSettings
    } catch (e) {
      console.error('Space: cloud/auth unavailable:', e)
      return
    }

    const { signIn, signOut, onAuthChange, isAuthorized } = auth

    function handleSignOut() { signOut().catch(console.error) }
    document.getElementById('page-signin-btn')!.addEventListener('click', async () => {
      try { await signIn() } catch (e) { console.error(e) }
    })
    document.getElementById('page-signout-btn')!.addEventListener('click', handleSignOut)
    document.getElementById('page-signout-btn-unauth')!.addEventListener('click', handleSignOut)

    onAuthChange(async (user: any) => {
      if (!user) {
        showAuthState('signedout')
        return
      }
      if (!isAuthorized(user.email)) {
        showAuthState('unauthorized')
        await signOut()
        return
      }
      userAvatar.src = user.photoURL || ''
      userName.textContent = user.displayName || user.email || ''
      showAuthState('authorized')
      const settings = await getSettings()
      if (settings?.defaultLanding) landingSelect.value = settings.defaultLanding
    })

    landingSelect.addEventListener('change', async () => {
      try {
        await saveSettings({ defaultLanding: landingSelect.value })
        saveFeedback.textContent = getMsg('settings.page.saved')
        saveFeedback.dataset.state = 'ok'
      } catch {
        saveFeedback.textContent = getMsg('settings.page.errorSaving')
        saveFeedback.dataset.state = 'error'
      }
      saveFeedback.hidden = false
      if (saveFeedbackTimer) clearTimeout(saveFeedbackTimer)
      saveFeedbackTimer = setTimeout(() => { saveFeedback.hidden = true }, 2500)
    })
  })()
</script>
