---
import MainLayout from '../../layouts/MainLayout.astro'
import MosaicCard from '../../components/cards/MosaicCard.astro'
import projects from '../../data/projects.json'
import tools from '../../data/tools.json'
import games from '../../data/games.json'

const iconModules = import.meta.glob('../../icons/mosaic/*.svg', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>

function iconFor(slug: string): string {
  const match = Object.entries(iconModules).find(([path]) => path.endsWith(`/${slug}.svg`))
  return match ? match[1] : iconModules['../../icons/mosaic/_placeholder.svg']
}

const items = [
  ...projects.map(p => ({ slug: p.slug, title: p.title, labels: p.labels, size: p.size, href: `/projects/${p.slug}`, category: 'p' as const })),
  ...tools.map(t => ({ slug: t.slug, title: t.title, labels: t.labels, size: t.size, href: `/tools/${t.slug}`, category: 't' as const })),
  ...games.map(g => ({ slug: g.slug, title: g.title, labels: g.labels, size: g.size, href: `/games/${g.slug}`, category: 'g' as const })),
]
---

<MainLayout title="Projects">
  <div class="mosaic-grid">
    {items.map(item => (
      <MosaicCard
        href={item.href}
        title={item.title}
        labels={item.labels}
        category={item.category}
        size={item.size}
        icon={iconFor(item.slug)}
      />
    ))}
  </div>
</MainLayout>

<style is:global>
  @import '../../styles/sections/projects-index.css';
</style>
