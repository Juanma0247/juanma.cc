---
import MainLayout from '../../layouts/MainLayout.astro'
import MosaicCard from '../../components/cards/MosaicCard.astro'
import projects from '../../data/projects.json'
import tools from '../../data/tools.json'
import games from '../../data/games.json'
import { built, type BuiltSize } from '../../data/built'

const iconModules = import.meta.glob('../../icons/mosaic/*.svg', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>

function iconFor(slug: string): string {
  const match = Object.entries(iconModules).find(([path]) => path.endsWith(`/${slug}.svg`))
  return match ? match[1] : iconModules['../../icons/mosaic/_placeholder.svg']
}

interface Item {
  title: string
  labels: string[]
  size: BuiltSize
  href: string
  category: 'p' | 't' | 'g' | 'b'
  icon?: string
  iconSrc?: string
}

const items: Item[] = [
  ...built.map(b => ({ title: b.name, labels: b.tags, size: b.size, href: `/projects/built/${b.slug}`, category: 'b' as const, iconSrc: b.logo })),
  ...projects.map(p => ({ title: p.title, labels: p.labels, size: p.size as BuiltSize, href: `/projects/${p.slug}`, category: 'p' as const, icon: iconFor(p.slug) })),
  ...tools.map(t => ({ title: t.title, labels: t.labels, size: t.size as BuiltSize, href: `/tools/${t.slug}`, category: 't' as const, icon: iconFor(t.slug) })),
  ...games.map(g => ({ title: g.title, labels: g.labels, size: g.size as BuiltSize, href: `/games/${g.slug}`, category: 'g' as const, icon: iconFor(g.slug) })),
]
---

<MainLayout title="Projects">
  <div class="mosaic-grid">
    {items.map(item => (
      <MosaicCard
        href={item.href}
        title={item.title}
        labels={item.labels}
        category={item.category}
        size={item.size}
        icon={item.icon}
        iconSrc={item.iconSrc}
      />
    ))}
  </div>
</MainLayout>

<style is:global>
  @import '../../styles/sections/projects-index.css';
</style>
