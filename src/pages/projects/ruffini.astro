---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="ruffini">
  <div class="field">
    <input id="p6i1" required="" type="text" value="7 8 0 4" placeholder=" ">
    <label class="field-label" data-i18n="pd.ruffini.coefficients">Coefficients</label>
  </div>
  <h2 class="inLine" data-i18n="pd.ruffini.polynomial">Polynomial:</h2>
  <div class="latex inLine" id="p6Preview"></div>
  <br>
  <h2 class="inLine" data-i18n="pd.ruffini.process">Process:</h2>
  <div class="latex inLine" id="p6Process"></div>
  <div class="latex inLine" id="p6Process2"></div>
  <br>
  <h2 class="inLine" data-i18n="pd.ruffini.result">Result:</h2>
  <div class="latex inLine" id="p6Res"></div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';</style>
<script type="module" is:inline>
  import Ruffini from '/js/lib/Ruffini.js'
  const p = new Ruffini(); p.starter?.(); p.main()
</script>
