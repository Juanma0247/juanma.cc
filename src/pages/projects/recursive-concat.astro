---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="recursive-concat">
  <div class="cc-page">
    <header class="cc-header">
      <h1 class="cc-title">Recursive Concatenation</h1>
      <p class="cc-sub">See how <b>α · β</b> is built one character at a time, peeling <b>β</b> down to the base case.</p>
    </header>

    <div class="cc-inputs">
      <div class="field">
        <input id="p16iAlpha" autocomplete="off" required value="a" placeholder=" ">
        <label class="field-label">String α (prefix)</label>
      </div>
      <div class="field">
        <input id="p16iBeta" autocomplete="off" required value="bcde" placeholder=" ">
        <label class="field-label">String β (to concatenate)</label>
      </div>
    </div>

    <div class="cc-key">
      <span class="cc-key-item"><span class="cc-sw cc-c-alpha"></span>α · prefix</span>
      <span class="cc-key-item"><span class="cc-sw cc-c-gamma"></span>γ · remaining</span>
      <span class="cc-key-item"><span class="cc-sw cc-c-a"></span>last character</span>
    </div>

    <div id="p16r1" class="cc-stage"></div>

    <div class="cc-controls" id="p16controls" hidden>
      <div class="cc-nav">
        <button type="button" class="cc-arrow" id="p16prev" aria-label="Previous step">
          <span aria-hidden="true">←</span>
        </button>
        <div class="cc-steps-rail" id="p16dots"></div>
        <button type="button" class="cc-arrow" id="p16next" aria-label="Next step">
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <button type="button" class="cc-auto" id="p16play" aria-pressed="false">
        <span class="cc-play-icon" aria-hidden="true">▶</span>
        <span class="cc-play-label">Auto</span>
      </button>
    </div>

    <p class="cc-hint-keys">Move with the buttons, the ← → arrow keys, or the numbered steps.</p>
  </div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';</style>
<style is:global>@import '../../styles/sections/projects-concat.css';</style>
<script type="module" is:inline>
  import RecursiveConcat from '/js/lib/RecursiveConcat.js'
  const p = new RecursiveConcat(); p.starter?.(); p.main()
</script>
