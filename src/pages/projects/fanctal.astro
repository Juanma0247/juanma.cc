---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="fanctal">
  <div class="p11Content">
    <header class="p11Intro">
      <p class="p11Lead" data-i18n="pd.fanctal.introLead">A fanctal is a family of self-similar circular fractals, built by dividing a disk into equal angular sectors and inscribing, in some of them, a smaller tangent disk that repeats the same construction inside itself, indefinitely. Varying how many sectors there are and how many are recursed traces out an entire family of shapes — from sparse, spidery patterns to dense, almost space-filling ones — all sharing the same self-similar logic. Explore that family below, or read the summary and download a Python implementation further down the page.</p>
    </header>

    <div class="p11Layout">
      <div class="p11FigureCard">
        <svg id="fanctal"></svg>
      </div>
      <aside class="p11Panel">
        <h3 class="p11PanelTitle" data-i18n="pd.fanctal.paramsTitle">Parameters</h3>
        <div class="p11inputs">
          <div class="field p11InputGroup">
            <input id="p11i1" required="" type="number" min="1" step="1" value="6" placeholder=" ">
            <label class="field-label">\(\text&#123;\textbf&#123;n&#125;&#125;\)</label>
            <p class="p11Hint" data-i18n="pd.fanctal.hintN">Number of angular sectors</p>
          </div>
          <div class="field p11InputGroup">
            <input id="p11i2" required="" type="number" min="0" step="1" value="3" placeholder=" ">
            <label class="field-label">\(\text&#123;\textbf&#123;a&#125;&#125;\)</label>
            <p class="p11Hint" data-i18n="pd.fanctal.hintA">Sectors selected to recurse</p>
          </div>
          <div class="field p11InputGroup">
            <input id="p11i3" required="" type="number" placeholder=" ">
            <label class="field-label" data-i18n="pd.fanctal.depth">\(\text&#123;\textbf&#123;Depth&#125;&#125;\)</label>
            <p class="p11Hint" data-i18n="pd.fanctal.hintDepth">Explicit depth 1–7 (empty = automatic cutoff)</p>
          </div>
        </div>
        <div class="p11PanelFoot">
          <button id="p11AnimBtn" class="p11AnimBtn">
            <i data-feather="film"></i>
            <span data-i18n="pd.fanctal.animateBtn">Animation</span>
          </button>
        </div>
      </aside>
    </div>

    <div class="p11ActionsCard">
      <div class="p11buttons">
        <button id="p11b1" class="p11Button" data-i18n="pd.fanctal.aboutBtn">About the fanctal</button>
        <button id="p11b2" class="p11Button" data-i18n="pd.fanctal.downloadSvg">Download SVG</button>
      </div>
      <div id="p11ResArea"></div>
    </div>

    <section class="p11AreaSection">
      <h3 data-i18n="pd.fanctal.areaCalc">Area calculation A(r, n, a)</h3>
      <div id="p11AreaCalc" class="p11AreaCalc"></div>
    </section>

    <section id="p11About" class="p11About">
      <h3 data-i18n="pd.fanctal.aboutTitle">About the fanctal</h3>
      <p data-i18n="pd.fanctal.aboutConstruction">The original fanctal divides a disk of radius \(R\) into \(6\) congruent sectors and inscribes, in \(3\) alternating sectors, a tangent child disk; the construction repeats indefinitely inside each child.</p>

      <div class="p11AboutGrid">
        <div class="p11AboutCard">
          <h4 data-i18n="pd.fanctal.resultAreaLabel">Main result</h4>
          <p data-i18n="pd.fanctal.resultAreaText">The shaded area equals \(\pi R^2/4\) — proved by two independent methods. The perimeter added at each generation is invariant, \(\pi R + 6R\), but the sum over all generations diverges.</p>
        </div>
        <div class="p11AboutCard">
          <h4 data-i18n="pd.fanctal.generalizationLabel">Generalization</h4>
          <p data-i18n="pd.fanctal.generalizationText">The construction generalizes to a parametric family \(f(r,n,a)\): \(n\) angular sectors, of which \(a\) (preferably alternated) are selected to recurse, with scale ratio \(k(n) = \dfrac&#123;\sin(\pi/n)&#125;&#123;1+\sin(\pi/n)&#125;\). Its closed-form area is \(A(r,n,a) = \pi r^2 \cdot \dfrac&#123;a\left(\frac&#123;1&#125;&#123;n&#125; - k^2\right)&#125;&#123;1 - ak^2&#125;\), valid for every admissible \((n,a)\); setting \(n=6\), \(a=3\) recovers exactly \(\pi R^2/4\).</p>
        </div>
        <div class="p11AboutCard">
          <h4 data-i18n="pd.fanctal.dimensionLabel">Fractal dimension</h4>
          <p data-i18n="pd.fanctal.dimensionText">The family's self-similar attractor has Hausdorff dimension \(\dim_H(K) = \dfrac&#123;\log a&#125;&#123;-\log k&#125;\), which equals exactly \(1\) when \(ak=1\) — the same condition connected to the invariant perimeter of the original fanctal.</p>
        </div>
      </div>

      <div class="p11Paper">
        <p class="p11PaperMeta" data-i18n="pd.fanctal.paperMeta">Yasser Díaz Arcila, Juan Manuel Díaz Gómez, and Elizabeth Solórzano Tovar.</p>
        <p class="p11PaperStatus" data-i18n="pd.fanctal.paperStatus">A version restructured for peer review is in preparation for submission to Eco Matemático (Universidad Francisco de Paula Santander).</p>
        <button id="p11PdfBtn" class="p11PdfBtn" hidden>
          <i data-feather="download"></i>
          <span data-i18n="pd.fanctal.downloadPdf">Download PDF</span>
        </button>
        <p class="p11License" data-i18n="pd.fanctal.licenseNote">It will be published under a CC BY 4.0 license.</p>
      </div>
    </section>

    <section class="p11CodeSection">
      <h3 data-i18n="pd.fanctal.codeTitle">Reproduce it yourself</h3>
      <p data-i18n="pd.fanctal.codeIntro">This script (available in Python and in R) implements the same recursive construction described above and, in addition, reproduces the three independent methods the article uses to verify the area (by generations, by self-similarity, and by Monte Carlo), so you can regenerate every figure and every number in Table I independently.</p>
      <div class="p11CodeCard">
        <div class="p11CodeToolbar">
          <div id="p11CodeLangGroup" class="p11CodeLangGroup" role="group" data-i18n-aria-label="pd.fanctal.codeLangLabel" aria-label="Script language">
            <button type="button" class="p11CodeLangBtn is-active" data-lang="python">Python</button>
            <button type="button" class="p11CodeLangBtn" data-lang="r">R</button>
          </div>
          <span id="p11CodeFilename" class="p11CodeFilename">fanctal.py</span>
          <div class="p11CodeActions">
            <button id="p11CodeToggle" class="p11CodeBtn" data-i18n="pd.fanctal.codeShow">Show code</button>
            <button id="p11CodeCopy" class="p11CodeBtn" data-i18n="pd.fanctal.codeCopy">Copy</button>
            <a id="p11CodeDownload" class="p11CodeBtn is-solid" href="/scripts/fanctal.py" download="fanctal.py" data-i18n="pd.fanctal.codeDownload">Download</a>
          </div>
        </div>
        <pre id="p11CodePre" class="p11CodePre" hidden><code id="p11CodeBlock" class="language-python"></code></pre>
      </div>
    </section>

    <section class="p11ResultsSection">
      <h3 data-i18n="pd.fanctal.resultsTitle">Expected output</h3>
      <p data-i18n="pd.fanctal.resultsIntro">The numerical verification reproduces the six (n, a) pairs from Table I of the article. Methods 1 and 2 are deterministic and match the figures shown exactly; Method 3 (Monte Carlo, N = 10&#8310; points) is random and is only expected to match within its standard error.</p>
      <div class="p11ResultsTableWrap">
        <table class="p11ResultsTable">
          <thead>
            <tr>
              <th>n</th>
              <th>a</th>
              <th>k</th>
              <th data-i18n="pd.fanctal.resultsColM1">Method 1</th>
              <th data-i18n="pd.fanctal.resultsColM2">Method 2</th>
              <th>Monte Carlo</th>
              <th>z</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>3</td><td>1</td><td>0.4641</td><td>0.150321</td><td>0.150321</td><td>0.149848 &#177; 0.000357</td><td>&minus;1.32</td></tr>
            <tr><td>4</td><td>2</td><td>0.4142</td><td>0.238796</td><td>0.238796</td><td>0.238064 &#177; 0.000426</td><td>&minus;1.72</td></tr>
            <tr><td>5</td><td>2</td><td>0.3702</td><td>0.173458</td><td>0.173458</td><td>0.173436 &#177; 0.000379</td><td>&minus;0.06</td></tr>
            <tr><td>6</td><td>3</td><td>0.3333</td><td>0.250000</td><td>0.250000</td><td>0.249860 &#177; 0.000433</td><td>&minus;0.32</td></tr>
            <tr><td>8</td><td>4</td><td>0.2768</td><td>0.279120</td><td>0.279120</td><td>0.279041 &#177; 0.000449</td><td>&minus;0.18</td></tr>
            <tr><td>12</td><td>6</td><td>0.2056</td><td>0.330082</td><td>0.330082</td><td>0.329808 &#177; 0.000470</td><td>&minus;0.58</td></tr>
          </tbody>
        </table>
      </div>
      <p class="p11ResultsNote" data-i18n="pd.fanctal.resultsNote">R's Monte Carlo uses a different random number generator from Python's fixed-seed PCG64, so it will not reproduce the same digits: it should only fall within statistical error, with |z| below 2, of the exact value.</p>
    </section>
  </div>

  <div id="p11Fs" class="p11Fs" hidden>
    <div id="p11FsStage" class="p11FsStage"></div>
    <aside class="p11FsPanel">
      <div class="p11FsHead">
        <h3 class="p11FsTitle" data-i18n="pd.fanctal.animTitle">Animation</h3>
        <button id="p11FsExit" class="p11FsExit">
          <i data-feather="minimize-2"></i>
          <span data-i18n="pd.fanctal.animExit">Exit view</span>
        </button>
      </div>
      <div class="p11FsProgress">
        <div class="p11FsProgressHead">
          <span id="p11FsFrame" class="p11FsFrame"></span>
          <span id="p11FsCount" class="p11FsCount"></span>
        </div>
        <span class="p11FsBar"><span id="p11FsBarFill" class="p11FsBarFill"></span></span>
      </div>
      <div id="p11FsArea" class="p11FsArea"></div>
      <div class="p11FsControls">
        <button id="p11FsPlay" class="p11FsCtrl is-solid">
          <i data-feather="play"></i>
          <span data-i18n="pd.fanctal.animStart">Start</span>
        </button>
        <button id="p11FsStop" class="p11FsCtrl">
          <i data-feather="square"></i>
          <span data-i18n="pd.fanctal.animStop">Stop</span>
        </button>
      </div>
      <div id="p11FsInputs" class="p11FsInputs"></div>
      <p class="p11FsHint" data-i18n="pd.fanctal.animHint">It runs through every valid pair (n, a) with 2 ≤ n ≤ 20 and 1 ≤ a ≤ n − 1, speeding up as n grows. Changing any parameter stops it and draws the values you typed.</p>
    </aside>
  </div>

  <div class="space-bottom"></div>
</ProjectLayout>
<style is:global>@import '../../styles/sections/projects-fanctal.css';</style>
<script type="module" is:inline>
  import Fanctal from '/js/lib/Fanctal.js'
  import hljs from 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/es/highlight.min.js'

  const p = new Fanctal(); p.starter?.(); p.main()

  const LANGS = {
    python: { file: '/scripts/fanctal.py', hljsClass: 'language-python', filename: 'fanctal.py' },
    r: { file: '/scripts/fanctal.R', hljsClass: 'language-r', filename: 'fanctal.R' },
  }
  let currentLang = 'python'
  const codeCache = {}

  const codeToggle = document.getElementById('p11CodeToggle')
  const codeCopy = document.getElementById('p11CodeCopy')
  const codePre = document.getElementById('p11CodePre')
  const codeBlock = document.getElementById('p11CodeBlock')
  const codeFilename = document.getElementById('p11CodeFilename')
  const codeDownload = document.getElementById('p11CodeDownload')
  const codeLangGroup = document.getElementById('p11CodeLangGroup')

  async function loadCode(lang) {
    if (codeCache[lang]) return codeCache[lang]
    const res = await fetch(LANGS[lang].file)
    const text = await res.text()
    codeCache[lang] = text
    return text
  }

  async function renderCode(lang) {
    const text = await loadCode(lang)
    codeBlock.className = LANGS[lang].hljsClass
    codeBlock.textContent = text
    delete codeBlock.dataset.highlighted
    hljs.highlightElement(codeBlock)
  }

  function setLang(lang) {
    currentLang = lang
    codeFilename.textContent = LANGS[lang].filename
    codeDownload.href = LANGS[lang].file
    codeDownload.setAttribute('download', LANGS[lang].filename)
    codeLangGroup?.querySelectorAll('.p11CodeLangBtn').forEach(btn => {
      btn.classList.toggle('is-active', btn.dataset.lang === lang)
    })
  }

  codeLangGroup?.addEventListener('click', async (e) => {
    const btn = e.target.closest('.p11CodeLangBtn')
    if (!btn || btn.dataset.lang === currentLang) return
    setLang(btn.dataset.lang)
    if (!codePre.hidden) await renderCode(currentLang)
  })

  codeToggle?.addEventListener('click', async () => {
    const willShow = codePre.hidden
    if (willShow) await renderCode(currentLang)
    codePre.hidden = !willShow
    const key = willShow ? 'pd.fanctal.codeHide' : 'pd.fanctal.codeShow'
    const fallback = willShow ? 'Hide code' : 'Show code'
    codeToggle.dataset.i18n = key
    codeToggle.textContent = window.i18nGet ? window.i18nGet(key, fallback) : fallback
  })

  codeCopy?.addEventListener('click', async () => {
    const text = await loadCode(currentLang)
    navigator.clipboard.writeText(text)
    const original = codeCopy.textContent
    codeCopy.textContent = window.i18nGet ? window.i18nGet('pd.fanctal.codeCopied', 'Copied!') : 'Copied!'
    setTimeout(() => { codeCopy.textContent = original }, 1500)
  })
</script>
