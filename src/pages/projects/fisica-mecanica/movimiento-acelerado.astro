---
import MechanicsLayout from '../../../layouts/MechanicsLayout.astro'
import TopicPage from '../../../components/mechanics/TopicPage.astro'
import { accelerated } from '../../../data/i18n/mechanics/accelerated'

const d = accelerated.en
---

<MechanicsLayout topic="accelerated">
  <TopicPage topic="accelerated" stage="wide">
    <section class="mxSection">
      <h2 class="mxH2" data-i18n="pd.mechanics.accelerated.encounter.title">{d.encounter.title}</h2>
      <p class="mxSectionLead" data-i18n="pd.mechanics.accelerated.encounter.lead" set:html={d.encounter.lead} />
      <div id="mxEncounter" class="mxModule"></div>
    </section>
    <section class="mxSection">
      <h2 class="mxH2" data-i18n="pd.mechanics.accelerated.phases.title">{d.phases.title}</h2>
      <p class="mxSectionLead" data-i18n="pd.mechanics.accelerated.phases.lead" set:html={d.phases.lead} />
      <div id="mxPhases" class="mxModule"></div>
    </section>
  </TopicPage>
</MechanicsLayout>
