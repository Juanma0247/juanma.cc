---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="cross-matrix">
  <script slot="head" is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.11.13/p5.js"></script>
  <div id="p13container">
    <div id="p13canvas"></div>

    <div class="p13Panel p13Panel--top">
      <p class="p13Intro" data-i18n="pd.crossMatrix.introText">This renders a cost matrix as a 3D terrain and finds the cheapest path across it: starting at the row you pick, moving one column at a time, free to step to the row above or below at each step. The highlighted path is the minimum-cost route, found with dynamic programming. Drag to rotate, scroll to zoom.</p>

      <div class="control">
        <label><span data-i18n="pd.crossMatrix.startLabel">Start:</span> <span id="p13StartRowValue">0</span></label>
        <input type="range" id="p13StartRow" min="0" max="29" value="0">
      </div>
      <p class="p13Hint" data-i18n="pd.crossMatrix.startHint">Row the path starts from, on the left edge of the grid.</p>
    </div>

    <div class="p13presets">
      <p class="p13prefunc">\(f(x, y)\)</p>
    </div>

    <div class="p13Panel p13Panel--bottom">
      <div class="p13ranges">
        <div class="field">
          <input id="p13i21" required="" value="0 10" placeholder=" ">
          <label class="field-label">\(x_0 \quad x_n\)</label>
        </div>
        <div class="field">
          <input id="p13i22" required="" value="0 10" placeholder=" ">
          <label class="field-label">\(y_0 \quad y_n\)</label>
        </div>
      </div>
      <div class="p13functions">
        <div class="field">
          <input id="p13i23" required="" value="10*sin(x) + 8*cos(y*1.5) + 5*sin(x*y/10) + 20" placeholder=" ">
          <label class="field-label">\(f(x, y)\)</label>
        </div>
        <button id="p13b21" data-i18n="pd.crossMatrix.generate">Generate</button>
      </div>
      <p id="p13presetsBotton" data-i18n="pd.crossMatrix.presetFunctions">Preset functions</p>
    </div>

    <div class="p13output">
      <span class="label" data-i18n="pd.crossMatrix.totalCost">Total cost: </span>
      <span class="value highlight" id="p13TotalCost">0</span>
    </div>
  </div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style is:global>@import '../../styles/sections/projects-cross-matrix.css';</style>
<script type="module" is:inline>
  import CrossMatrix from '/js/lib/CrossMatrix.js'
  const p = new CrossMatrix(); p.starter?.(); p.main()
</script>
