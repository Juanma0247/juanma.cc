---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="t-student">
  <script slot="head" is:inline defer src="https://cdn.jsdelivr.net/npm/jsxgraph@1.13.2/distrib/jsxgraphcore.min.js"></script>
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsxgraph@1.13.2/distrib/jsxgraph.css" />
  <div style="display: flex; flex-wrap: wrap;">
    <div id="p8PlotContainer" class="plotContainer"></div>
    <div id="p8CalcContainer" class="calcContainer">
      <div class="field">
        <input id="p8i1" required="" placeholder=" ">
        <label class="field-label">\(P(X) \quad\text&#123;or&#125;\quad X\)</label>
      </div>
      <div class="field">
        <input id="p8i2" required="" placeholder=" ">
        <label class="field-label">\(\text&#123;Degrees of freedom&#125;\)</label>
      </div>
      <div class="latex inLine" id="p8Res1"></div>
      <div class="latex inLine" id="p8Res2"></div>
    </div>
  </div>
  <div class="space-bottom"></div>
</ProjectLayout>
<script type="module" is:inline>
  import TStudent from '/js/lib/TStudent.js'
  const p = new TStudent(); p.starter?.(); p.main()
</script>
