---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="voice">
  <h1 class="subtitle">Voice Register</h1>
  <div class="center voice-row">
    <div class="field">
      <input id="p4i1" required="" type="text" class="voice-name-input" placeholder=" ">
      <label class="field-label">Audio name</label>
    </div>
    <audio class="voice-preview" id="audioPreview" controls></audio>
  </div>
  <div class="center voice-row">
    <button id="startRecording">Start Recording</button>
    <button id="stopRecording" disabled>Stop Recording</button>
    <button id="uploadAudio" disabled>Upload Audio</button>
  </div>
  <p class="voice-saved-title">Saved audio</p>
  <div id="audiosGuardados" class="center"></div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';
  @import '../../styles/sections/projects-voice.css';</style>
<script type="module" is:inline>
  import Voice from '/js/lib/Voice.js'
  const p = new Voice(); p.starter?.(); p.main()
</script>
