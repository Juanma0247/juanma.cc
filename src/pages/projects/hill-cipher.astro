---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---

<ProjectLayout slug="hill-cipher">
  <h1 class="subtitle">Hill Cipher</h1>

  <div class="input-group">
    <input id="p1i1" required type="text" />
    <label class="user-label">Alphabet</label>
  </div>
  <div class="input-group">
    <input id="p1i2" required type="text" />
    <label class="user-label">Key text</label>
    <p class="p1Error" id="p1e1"></p>
  </div>
  <div class="input-group">
    <input id="p1i3" required type="text" />
    <label class="user-label">Text to encrypt or decrypt</label>
  </div>

  <div class="center">
    <p class="p1result-label">Encrypted text</p>
    <input class="result" id="p1r1" placeholder="..." />
  </div>
  <div class="center">
    <p class="p1result-label">Decrypted text</p>
    <input class="result" id="p1r2" placeholder="..." />
  </div>

  <div class="p1ContOptions">
    <h2 id="p1Introduction" class="p1Option">Introduction</h2>
    <h2 id="p1Instructions" class="p1Option">Instructions</h2>
    <h2 id="p1Process" class="p1Option">Process</h2>
  </div>

  <div id="p1ContIntroduction" style="display: none;">
    <p class="p1Descripcion">
      The Hill cipher is a cryptographic method developed by mathematician Lester S. Hill in 1929.
      It is based on linear algebra and uses matrices to transform blocks of plaintext into ciphertext.
    </p>
  </div>

  <div id="p1ContInstructions" style="display: none;">
    <p class="p1Descripcion">
      1. Define your alphabet in the first field.<br />
      2. Enter a key text (at least 4 characters). The matrix size is derived from the square root of its length.<br />
      3. Enter the text you want to encrypt or decrypt.<br />
      4. The results appear automatically.
    </p>
  </div>

  <div id="p1ContProcess" style="display: none;">
    <h3 class="latex">Character table</h3>
    <div id="p1TablaDeCaracteres" class="latex"></div>
    <h3 class="latex">Cipher matrix (MC)</h3>
    <div id="p1MatrizDeCifrado" class="latex"></div>
    <h3 class="latex">Message matrices</h3>
    <div id="p1Matries" class="latex"></div>
    <h3 class="latex">MC × Matrices</h3>
    <div id="p1MCPorMatrices" class="latex"></div>
    <h3 class="latex">MC inverse</h3>
    <div id="p1MCInversa" class="latex"></div>
    <h3 class="latex">MC⁻¹ × Matrices</h3>
    <div id="p1MCIPorMatrices" class="latex"></div>
  </div>

  <div class="space-bottom"></div>
</ProjectLayout>

<style>
  @import '../../styles/sections/projects.css';
  @import '../../styles/sections/projects-hill-cipher.css';
</style>

<script type="module" is:inline>
  import HillCipher from '/js/lib/HillCipher.js'
  const p1 = new HillCipher()
  p1.starter()
  p1.main()
</script>