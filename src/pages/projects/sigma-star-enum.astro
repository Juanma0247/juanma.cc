---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="sigma-star-enum">
  <div id="p15container">
    <h1 class="p15title subtitulo" data-i18n="pd.sigmaStar.title">Enumeration of Σ*</h1>
  </div>
  <div class="p15-controls">
    <div class="field">
      <input id="p15alphabet" autocomplete="off" required="" value="1 2 3 4 5 6 7 8 9 0" placeholder=" ">
      <label class="field-label" data-i18n="pd.sigmaStar.alphabetLabel">Alphabet Σ (symbols separated by spaces)</label>
    </div>
    <div class="p15-row">
      <div class="p15-select-wrap">
        <select id="p15mode">
          <option value="n2s" data-i18n="pd.sigmaStar.optN2S">ℕ → Σ*  (number to string)</option>
          <option value="s2n" data-i18n="pd.sigmaStar.optS2N">Σ* → ℕ  (string to number)</option>
        </select>
        <span class="p15-select-arrow">▾</span>
      </div>
      <div class="field p15-query-group">
        <input id="p15query" autocomplete="off" required="" value="1" placeholder=" ">
        <label class="field-label" id="p15queryLabel" data-i18n="pd.sigmaStar.queryLabel">Number n ∈ ℕ</label>
      </div>
    </div>
  </div>
  <div class="p15-results-header"></div>
  <div id="p15r1" class="p15-result-area">
    <p class="p15-hint">Enter a number to see the process.</p>
  </div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';
  @import '../../styles/sections/projects-sigma-star.css';</style>
<script type="module" is:inline>
  import SigmaStarEnum from '/js/lib/SigmaStarEnum.js'
  const p = new SigmaStarEnum(); p.starter?.(); p.main()
</script>
