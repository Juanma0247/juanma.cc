---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="sets">
  <script slot="head" is:inline defer src="https://www.geogebra.org/apps/deployggb.js"></script>
  <script slot="head" is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.js"></script>
  <h1 class="subtitle p2subtitulo" data-i18n="pd.sets.title">Sets</h1>
  <div id="p2Options0" class="center p2Options"></div>
  <div style="display: flex;" class="center p2InputSets">
    <div class="field">
      <input id="p2i1" required="" type="text" class="p2input" placeholder=" ">
      <label class="field-label" data-i18n="pd.sets.setA">Set A</label>
    </div>
    <button id="p2bchange" style="margin-top: .7rem;">
      <img src="/img/change.svg" class="p2icos" alt="" aria-hidden="true"/>
    </button>
    <button id="p2bsetSet" style="margin-top: .7rem; margin-left: .7rem;">
      <img src="/img/keys.svg" class="p2icos" alt="" aria-hidden="true"/>
    </button>
    <div class="field">
      <input id="p2i2" required="" type="text" class="p2input" placeholder=" ">
      <label class="field-label" data-i18n="pd.sets.setB">Set B</label>
    </div>
  </div>
  <div id="p2Options1" class="center p2Options"></div>
  <div id="p2Options2" class="center p2Options"></div>
  <div id="p2Options3" class="center p2Options"></div>
  <div id="p2Options4" class="center p2Options"></div>
  <div class="latex center p2Latex" id="p2Res"></div>
  <div id="p2VeenDiagram" class="center"></div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';
  @import '../../styles/sections/projects-sets.css';</style>
<script type="module" is:inline>
  import Sets from '/js/lib/Sets.js'
  const p = new Sets(); p.starter?.(); p.main()
</script>
