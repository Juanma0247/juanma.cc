---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="regular-expressions">
  <div id="p14container">
    <h1 class="p14title subtitulo" data-i18n="pd.regex.title">Regular Expressions</h1>
  </div>
  <div class="field">
    <input id="p14i1" autocomplete="off" required="" value="a*b" placeholder=" ">
    <label class="field-label p14ul" data-i18n="pd.regex.exprLabel">Regular Expression</label>
  </div>
  <div id="p14extraAlphabets"></div>
  <h2 class="p14t1" data-i18n="pd.regex.resultLabel">Result:</h2>
  <div id="p14r1"></div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';
  @import '../../styles/sections/projects-regexp.css';</style>
<script type="module" is:inline>
  import RegularExpressions from '/js/lib/RegularExpressions.js'
  const p = new RegularExpressions(); p.starter?.(); p.main()
</script>
