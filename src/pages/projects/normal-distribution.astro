---
import ProjectLayout from '../../layouts/ProjectLayout.astro'
---
<ProjectLayout slug="normal-distribution">
  <div style="display: flex; flex-wrap: wrap;">
    <div id="p7ggbContainer" class="ggbContainer"></div>
    <div id="p7CalcContainer" class="calcContainer">
      <div class="field">
        <input id="p7i1" required="" placeholder=" ">
        <label class="field-label">\(X\)</label>
      </div>
      <div class="field">
        <input id="p7i2" required="" placeholder=" ">
        <label class="field-label">\(\mu\)</label>
      </div>
      <div class="field">
        <input id="p7i3" required="" placeholder=" ">
        <label class="field-label">\(\sigma\)</label>
      </div>
      <div class="latex inLine" id="p7Res1"></div>
      <div class="latex inLine" id="p7Res2"></div>
    </div>
  </div>
  <div class="space-bottom"></div>
</ProjectLayout>
<style>@import '../../styles/sections/projects.css';</style>
<script type="module" is:inline>
  import NormalDistribution from '/js/lib/NormalDistribution.js'
  const p = new NormalDistribution(); p.starter?.(); p.main()
</script>
