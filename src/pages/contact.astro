---
import MainLayout from '../layouts/MainLayout.astro'

interface SocialLink {
  id: string
  name: string
  nameKey?: string
  handle: string
  color: string
  icon: string
  href: string
  download?: string
}

const whatsappNumber = '573229130427'
const whatsappMessage = '¡Hola Juan Manuel! Te escribo desde tu página juanma.cc, me gustaría contactarte.'
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`

const gmailTo = 'juanmanueldiazgomez247@gmail.com'
const gmailSubject = 'Contacto desde juanma.cc'
const gmailBody = 'Hola Juan Manuel,\n\nTe escribo desde tu página juanma.cc.\n\n\nSaludos.'
const gmailHref = `https://mail.google.com/mail/u/0/?fs=1&to=${encodeURIComponent(gmailTo)}&su=${encodeURIComponent(gmailSubject)}&body=${encodeURIComponent(gmailBody)}&tf=cm`

const links: SocialLink[] = [
  { id: 'whatsapp', name: 'WhatsApp', handle: '+57 322 913 0427', color: '#25D366', icon: '/img/whatsapp.svg', href: whatsappHref },
  { id: 'gmail', name: 'Gmail', handle: gmailTo, color: '#EA4335', icon: '/img/gmail.svg', href: gmailHref },
  { id: 'discord', name: 'Discord', handle: 'juanma247', color: '#5865F2', icon: '/img/discord.svg', href: 'https://discord.com/users/751601938851692596' },
  { id: 'facebook', name: 'Facebook', handle: 'juanmanuel.diazgomez.1217', color: '#1877F2', icon: '/img/facebook.svg', href: 'https://www.facebook.com/juanmanuel.diazgomez.1217/' },
  { id: 'github', name: 'GitHub', handle: '@Juanma0247', color: '#181717', icon: '/img/github.svg', href: 'https://github.com/Juanma0247' },
  { id: 'linkedin', name: 'LinkedIn', handle: 'juanma247', color: '#0A66C2', icon: '/img/linkedin.svg', href: 'https://www.linkedin.com/in/juanma247/' },
  { id: 'orcid', name: 'ORCID', handle: '0009-0005-0892-0631', color: '#A6CE39', icon: '/img/orcid.svg', href: 'https://orcid.org/0009-0005-0892-0631' },
  { id: 'vcard', name: 'Save contact', nameKey: 'contact.saveContact', handle: 'Juan Diaz · +57 322 913 0427', color: 'var(--color-primary)', icon: '/img/contact-card.svg', href: '/contact/juan-manuel-diaz.vcf', download: 'Juan-Diaz.vcf' },
]
---

<MainLayout title="Contact" titleKey="nav.contact">
  <div class="contact-page">
    <p class="contact-intro" data-i18n="contact.intro">Let's talk! Pick whichever channel feels right and send me a message — I'd love to hear from you.</p>

    <div class="social-grid">
      {links.map(link => (
        <a
          class="social-card"
          href={link.href}
          download={link.download}
          target={link.download ? undefined : '_blank'}
          rel={link.download ? undefined : 'noopener noreferrer'}
          style={`--card-color: ${link.color}`}
        >
          <span class="social-card__icon"><img src={link.icon} alt="" aria-hidden="true" /></span>
          <span class="social-card__body">
            <span class="social-card__name" data-i18n={link.nameKey || undefined}>{link.name}</span>
            <span class="social-card__handle">{link.handle}</span>
          </span>
          {link.download ? (
            <svg class="social-card__action" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 3a1 1 0 0 1 1 1v7.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L9 11.586V4a1 1 0 0 1 1-1Z" />
              <path d="M4 14a1 1 0 0 1 1 1v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a1 1 0 1 1 2 0v1a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-1a1 1 0 0 1 1-1Z" />
            </svg>
          ) : (
            <svg class="social-card__action" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.293 4.293a1 1 0 0 1 1.414 0l5 5a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414-1.414L15.586 11H4a1 1 0 1 1 0-2h11.586l-3.293-3.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd" />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  @import '../styles/sections/contact.css';
</style>
