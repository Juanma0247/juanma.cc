---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="Settings" section="Settings" titleKey="settings.title">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Roboto:wght@400&family=Playfair+Display:wght@400&family=Montserrat:wght@400&family=Fira+Code:wght@400&display=swap"
  />
  <div class="settings-page">

    <div class="settings-webnote" id="settings-webnote" hidden>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 1a6 6 0 0 0-3.815 10.631C7.237 12.5 8 13.443 8 14.456v.644a.75.75 0 0 0 .572.729 6.016 6.016 0 0 0 2.856 0A.75.75 0 0 0 12 15.1v-.644c0-1.013.763-1.957 1.815-2.825A6 6 0 0 0 10 1ZM8.863 17.414a.75.75 0 0 0-.226 1.483 9.066 9.066 0 0 0 2.726 0 .75.75 0 0 0-.226-1.483 7.553 7.553 0 0 1-2.274 0Z" clip-rule="evenodd"/>
      </svg>
      <span class="settings-webnote__text" data-i18n="settings.web.active">The site is applying global settings.</span>
      <span class="settings-webnote__timer" id="settings-web-timer"></span>
    </div>

    <div class="settings-page__grid">

      <!-- Theme -->
      <section class="settings-card" id="settings-theme">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3.75 3A1.75 1.75 0 0 0 2 4.75v3.5C2 9.216 2.784 10 3.75 10H10v3.25A1.75 1.75 0 0 0 11.75 15h.5A1.75 1.75 0 0 0 14 13.25V10h2.25A1.75 1.75 0 0 0 18 8.25v-3.5A1.75 1.75 0 0 0 16.25 3H3.75Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="settings.theme.title">Theme</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.theme.desc">Choose how the site looks to you.</p>
        <div class="settings-theme__options">
          <button class="settings-theme__btn" data-theme="system">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M2 4.25A2.25 2.25 0 0 1 4.25 2h11.5A2.25 2.25 0 0 1 18 4.25v8.5A2.25 2.25 0 0 1 15.75 15h-3.105a3.501 3.501 0 0 0 1.1 1.677A.75.75 0 0 1 13.26 18H6.74a.75.75 0 0 1-.484-1.323A3.501 3.501 0 0 0 7.355 15H4.25A2.25 2.25 0 0 1 2 12.75v-8.5Z" clip-rule="evenodd"/></svg>
            <span data-i18n="settings.theme.system">System</span>
          </button>
          <button class="settings-theme__btn" data-theme="light">
            <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM6.464 14.596a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.596 15.657a.75.75 0 0 0 1.06-1.06l-1.06-1.061a.75.75 0 1 0-1.06 1.06l1.06 1.06ZM5.404 6.464a.75.75 0 0 0 1.06-1.06l-1.06-1.06a.75.75 0 1 0-1.061 1.06l1.06 1.06Z"/></svg>
            <span data-i18n="settings.theme.light">Light</span>
          </button>
          <button class="settings-theme__btn" data-theme="dark">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z" clip-rule="evenodd"/></svg>
            <span data-i18n="settings.theme.dark">Dark</span>
          </button>
          <button class="settings-theme__btn" data-theme="customizable">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.5 2A1.5 1.5 0 0 0 2 3.5V15a3 3 0 1 0 6 0V3.5A1.5 1.5 0 0 0 6.5 2h-3Zm11.753 6.99L9.5 14.743V6.257l1.51-1.51a1.5 1.5 0 0 1 2.122 0l2.121 2.121a1.5 1.5 0 0 1 0 2.122ZM8.364 18H16.5a1.5 1.5 0 0 0 0-3h-6.411a4.503 4.503 0 0 1-1.725 3ZM5 15a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z" clip-rule="evenodd"/></svg>
            <span data-i18n="settings.theme.custom">Custom</span>
          </button>
        </div>

        <div class="settings-theme__custom" id="settings-theme-custom" hidden>
          <div class="settings-custom__warnings" id="cp-warnings"></div>
          <div class="settings-custom__colors">
            <label class="settings-custom__item">
              <input type="color" id="cp-primary" value="#008888" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorPrimary">Primary</span>
              <span class="settings-custom__hex" id="cp-primary-hex">#008888</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="cp-text" value="#000000" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorText">Text</span>
              <span class="settings-custom__hex" id="cp-text-hex">#000000</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="cp-bg" value="#ffffff" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorBg">Background</span>
              <span class="settings-custom__hex" id="cp-bg-hex">#ffffff</span>
            </label>
            <label class="settings-custom__item">
              <input type="color" id="cp-muted" value="#888888" />
              <span class="settings-custom__item-name" data-i18n="settings.theme.colorMuted">Muted</span>
              <span class="settings-custom__hex" id="cp-muted-hex">#888888</span>
            </label>
          </div>
          <div class="cp-preview" id="cp-preview">
            <p class="cp-preview__label" data-i18n="settings.theme.previewLabel">Preview</p>
            <div class="cp-preview__page">
              <div class="cp-preview__topbar">
                <span class="cp-preview__brand">Juanma</span>
                <span class="cp-preview__navlink">Home</span>
                <span class="cp-preview__navlink cp-preview__navlink--active">About</span>
                <span class="cp-preview__navlink">Projects</span>
              </div>
              <div class="cp-preview__content">
                <h4 class="cp-preview__title" data-i18n="settings.theme.previewSection">Section title</h4>
                <p class="cp-preview__body">
                  <span data-i18n="settings.theme.previewBody">Body text content.</span>
                  <span class="cp-preview__muted" data-i18n="settings.theme.previewMuted">Secondary info.</span>
                </p>
                <div class="cp-preview__row">
                  <span class="cp-preview__btn">Button</span>
                  <span class="cp-preview__link">Link</span>
                </div>
              </div>
            </div>
          </div>
          <div class="settings-custom__presets">
            <span class="settings-custom__presets-label">Presets</span>
            <div class="settings-custom__presets-list">
              <button class="settings-custom__preset" data-preset="grayscale" data-i18n="settings.theme.presets.grayscale">Grayscale</button>
              <button class="settings-custom__preset" data-preset="pastels" data-i18n="settings.theme.presets.pastels">Pastels</button>
              <button class="settings-custom__preset" data-preset="warm" data-i18n="settings.theme.presets.warm">Warm</button>
              <button class="settings-custom__preset" data-preset="vintage" data-i18n="settings.theme.presets.vintage">Vintage</button>
              <button class="settings-custom__preset" data-preset="neon" data-i18n="settings.theme.presets.neon">Neon</button>
            </div>
          </div>
          <div class="settings-custom__actions">
            <button class="settings-custom__cancel" id="cp-cancel" data-i18n="settings.theme.cancel">Cancel</button>
            <button class="settings-custom__apply" id="cp-apply" data-i18n="settings.theme.apply">Apply</button>
          </div>
        </div>
      </section>

      <!-- Font -->
      <section class="settings-card" id="settings-font">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2.5 4A1.5 1.5 0 0 1 4 2.5h12A1.5 1.5 0 0 1 17.5 4v1A1.5 1.5 0 0 1 16 6.5h-5.5v9A1.5 1.5 0 0 1 9 17h-1a1.5 1.5 0 0 1-1.5-1.5v-9H2A1.5 1.5 0 0 1 .5 5V4Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="settings.font.title">Font</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.font.desc">Choose a global font for the site.</p>
        <select class="settings-font__select" id="settings-font-select">
          <option value="" data-i18n="settings.font.default" style="font-family: ProductSans;">Default</option>
          <option value="inter" style="font-family: 'Inter', sans-serif;">Inter</option>
          <option value="roboto" style="font-family: 'Roboto', sans-serif;">Roboto</option>
          <option value="playfair" style="font-family: 'Playfair Display', serif;">Playfair Display</option>
          <option value="montserrat" style="font-family: 'Montserrat', sans-serif;">Montserrat</option>
          <option value="fira-code" style="font-family: 'Fira Code', monospace;">Fira Code</option>
        </select>
      </section>

      <!-- Language -->
      <section class="settings-card" id="settings-language">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.664 1.319a.75.75 0 0 1 .672 0 41.059 41.059 0 0 1 8.198 5.424.75.75 0 0 1-.254 1.285 31.372 31.372 0 0 0-7.86 3.83.75.75 0 0 1-.84 0 31.508 31.508 0 0 0-2.08-1.287V9.48a31.517 31.517 0 0 0-2.073 1.316.75.75 0 0 1-.762.067A19.669 19.669 0 0 1 2.25 8.951a.75.75 0 0 1 0-1.183 20.842 20.842 0 0 1 3.744-2.465c.693-.38 1.41-.71 2.148-.984A41.028 41.028 0 0 1 9.664 1.319ZM10 4.097a37.441 37.441 0 0 0-3.73.733A37.528 37.528 0 0 0 10 7.366a37.528 37.528 0 0 0 3.73-2.536A37.441 37.441 0 0 0 10 4.097Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M10 10.047a31.514 31.514 0 0 0 3.73-2.537 31.375 31.375 0 0 1 5.476 3.697.75.75 0 0 1 0 1.183 19.667 19.667 0 0 1-3.062 1.834.75.75 0 0 1-.762-.067 31.508 31.508 0 0 0-2.08-1.287V14.6a31.517 31.517 0 0 0-2.072 1.316.75.75 0 0 1-.84 0 31.508 31.508 0 0 0-2.08-1.287v1.527a31.517 31.517 0 0 0-2.072 1.316.75.75 0 0 1-.762.067A19.669 19.669 0 0 1 2.25 15.582a.75.75 0 0 1 0-1.183 20.842 20.842 0 0 1 3.744-2.465 37.406 37.406 0 0 1 4.006-1.887Z" clip-rule="evenodd"/>
          </svg>
          <h3 data-i18n="settings.lang.title">Language</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.lang.desc">Switch the interface language.</p>
        <div class="settings-lang__options">
          <button class="settings-lang__btn settings-lang__btn--active" data-lang="en">English</button>
          <button class="settings-lang__btn" data-lang="es">Español</button>
        </div>
      </section>

      <!-- Account (save preferences) -->
      <section class="settings-card settings-card--auth" id="settings-account">
        <div class="settings-card__head">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.465 14.493a1.23 1.23 0 0 0 .41 1.412A9.957 9.957 0 0 0 10 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 0 0-13.074.003Z"/>
          </svg>
          <h3 data-i18n="settings.account.title">Save your preferences</h3>
        </div>
        <p class="settings-card__desc" data-i18n="settings.account.desc">Sign in with Google to keep your settings on your account, even if you clear your browsing history.</p>

        <div id="account-state-signedout">
          <button class="settings-google-btn" id="account-signin-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84Z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"/>
            </svg>
            <span data-i18n="settings.account.signIn">Sign in with Google</span>
          </button>
        </div>

        <div id="account-state-signedin" hidden>
          <div class="page-user-row">
            <img class="page-user-avatar" id="account-avatar" src="" alt="" />
            <div class="page-user-info">
              <span class="page-user-name" id="account-name"></span>
              <button class="settings-signout-btn" id="account-signout-btn">
                <span data-i18n="settings.account.signOut">Sign out</span>
              </button>
            </div>
          </div>
          <p class="settings-card__desc" data-i18n="settings.account.saved">Your preferences are saved to your account.</p>
        </div>
      </section>

    </div>

    <div class="settings-reset">
      <button class="settings-reset-btn" id="settings-reset" data-i18n="settings.reset">Reset to default</button>
      <span class="settings-reset__hint" data-i18n="settings.resetHint">Restores system defaults and stops applying the site's global settings.</span>
    </div>

    <div class="settings-storage-note">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/>
      </svg>
      <span data-i18n="settings.storageNote"></span>
    </div>
  </div>
</MainLayout>

<style>
  .settings-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .settings-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-content: start;
  }

  .settings-font__select {
    cursor: pointer;
    opacity: 1;
  }

  .settings-webnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--primary-10);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    font-family: var(--font-ui), sans-serif;
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .settings-webnote svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .settings-webnote__text { flex: 1; }

  .settings-webnote__timer {
    font-family: JetBrainsMono, monospace;
    font-weight: bold;
    color: var(--color-primary);
    background: var(--primary-15);
    border-radius: 2rem;
    padding: 0.1rem 0.55rem;
    flex-shrink: 0;
  }

  .settings-reset {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .settings-reset-btn {
    all: unset;
    font-family: var(--font-ui), sans-serif;
    font-size: 0.82rem;
    color: var(--color-muted);
    border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: var(--radius-md);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: border-color 160ms, color 160ms, background 160ms;
  }

  .settings-reset-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--primary-05);
  }

  .settings-reset__hint {
    font-family: var(--font-ui), sans-serif;
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .settings-storage-note {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 1rem;
    font-family: ProductSans, sans-serif;
    font-size: 0.72rem;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: 48rem;
  }

  .settings-storage-note svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    margin-top: 0.12rem;
    color: var(--color-primary);
    opacity: 0.75;
  }

  @media (max-width: 52rem) {
    .settings-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 34rem) {
    .settings-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import * as S from '../lib/core/settings.js'

  // These are the USER's own preferences (priority 2). They persist in the
  // browser (localStorage) and, when signed in, also in the cloud (users/{uid})
  // so they survive a history wipe. The effective look on screen is always
  // resolved by S.reapply() under the priority web (3) > user (2) > system (1).

  let uid: string | null = null
  function persistUser(fields: Record<string, any>) {
    if (uid) S.saveUserSettings(uid, fields).catch(console.error)
  }

  // ── Theme System ─────────────────────────────────────────────────────────────

  const THEME_KEY  = 'site-theme'
  const CUSTOM_KEY = 'site-theme-custom'
  const DEFAULT_THEME = 'system'

  const DEFAULTS = { primary: '#008888', text: '#000000', bg: '#ffffff', muted: '#888888' }

  const PRESETS: Record<string, typeof DEFAULTS> = {
    grayscale: { primary: '#555555', text: '#111111', bg: '#f5f5f5', muted: '#888888' },
    pastels:   { primary: '#6b9fae', text: '#2c4a52', bg: '#f0fafc', muted: '#8fb0bc' },
    warm:      { primary: '#c07840', text: '#2a1a00', bg: '#fdf4e8', muted: '#a07850' },
    vintage:   { primary: '#8b6914', text: '#2c1a00', bg: '#f5ecd7', muted: '#9a8050' },
    neon:      { primary: '#00ff88', text: '#ccffee', bg: '#001a0e', muted: '#00bb66' },
  }

  function relativeLuminance(hex: string): number {
    const n = parseInt(hex.replace('#', ''), 16)
    return [((n >> 16) & 255), ((n >> 8) & 255), (n & 255)]
      .map(c => { const s = c / 255; return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4) })
      .reduce((acc, c, i) => acc + c * [0.2126, 0.7152, 0.0722][i], 0)
  }

  function contrastRatio(a: string, b: string): number {
    const la = relativeLuminance(a), lb = relativeLuminance(b)
    return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)
  }

  function getSavedCustom(): typeof DEFAULTS | null {
    try { return JSON.parse(localStorage.getItem(CUSTOM_KEY) || 'null') } catch { return null }
  }

  const customPanel  = document.getElementById('settings-theme-custom') as HTMLElement
  const cpPrimary    = document.getElementById('cp-primary') as HTMLInputElement
  const cpText       = document.getElementById('cp-text')    as HTMLInputElement
  const cpBg         = document.getElementById('cp-bg')      as HTMLInputElement
  const cpMuted      = document.getElementById('cp-muted')   as HTMLInputElement
  const cpWarnings   = document.getElementById('cp-warnings') as HTMLElement
  const cpPreview    = document.getElementById('cp-preview')  as HTMLElement
  const hexPrimary   = document.getElementById('cp-primary-hex') as HTMLElement
  const hexText      = document.getElementById('cp-text-hex')    as HTMLElement
  const hexBg        = document.getElementById('cp-bg-hex')      as HTMLElement
  const hexMuted     = document.getElementById('cp-muted-hex')   as HTMLElement

  function getMsg(key: string): string {
    const lang = localStorage.getItem('site-lang') || 'en'
    const t = (window as any).__i18n?.[lang] ?? (window as any).__i18n?.en
    return key.split('.').reduce((o: any, k: string) => o?.[k], t) ?? key
  }

  function syncThemeButtons(name: string) {
    document.querySelectorAll<HTMLButtonElement>('.settings-theme__btn').forEach(btn => {
      btn.classList.toggle('settings-theme__btn--active', btn.dataset.theme === name)
    })
    customPanel.hidden = name !== 'customizable'
  }

  function setTheme(name: string) {
    localStorage.setItem(THEME_KEY, name)
    syncThemeButtons(name)
    S.reapply()
    persistUser({ theme: name })
  }

  let prevTheme = DEFAULT_THEME
  const currentTheme = localStorage.getItem(THEME_KEY) || DEFAULT_THEME
  if (currentTheme !== 'customizable') prevTheme = currentTheme
  syncThemeButtons(currentTheme)

  document.querySelectorAll<HTMLButtonElement>('.settings-theme__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.theme!
      if (t === 'customizable') {
        const stored = localStorage.getItem(THEME_KEY) || DEFAULT_THEME
        if (stored !== 'customizable') prevTheme = stored
        setTheme('customizable')
        loadPickerValues()
        return
      }
      setTheme(t)
    })
  })

  // ── Custom Picker ────────────────────────────────────────────────────────────

  function syncPicker() {
    hexPrimary.textContent = cpPrimary.value
    hexText.textContent    = cpText.value
    hexBg.textContent      = cpBg.value
    hexMuted.textContent   = cpMuted.value

    cpPreview.style.setProperty('--pv-primary', cpPrimary.value)
    cpPreview.style.setProperty('--pv-text',    cpText.value)
    cpPreview.style.setProperty('--pv-bg',      cpBg.value)
    cpPreview.style.setProperty('--pv-muted',   cpMuted.value)

    const c = { primary: cpPrimary.value, text: cpText.value, bg: cpBg.value }
    const checks = [
      { msg: getMsg('settings.theme.warnTextBg'),      a: c.text,    b: c.bg,      min: 4.5 },
      { msg: getMsg('settings.theme.warnPrimaryBg'),   a: c.primary, b: c.bg,      min: 3.0 },
      { msg: getMsg('settings.theme.warnTextPrimary'), a: c.text,    b: c.primary, min: 4.5 },
    ]
    const warnings = checks.filter(({ a, b, min }) => contrastRatio(a, b) < min)
    cpWarnings.innerHTML = warnings.map(({ msg }) =>
      `<span class="cp-warning--bad">⚠ ${msg}</span>`
    ).join('')
  }

  function loadPickerValues() {
    const saved = getSavedCustom() || DEFAULTS
    cpPrimary.value = saved.primary
    cpText.value    = saved.text
    cpBg.value      = saved.bg
    cpMuted.value   = saved.muted
    syncPicker()
  }

  if (currentTheme === 'customizable') loadPickerValues()

  ;[cpPrimary, cpText, cpBg, cpMuted].forEach(el => el.addEventListener('input', syncPicker))

  document.querySelectorAll<HTMLButtonElement>('.settings-custom__preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = PRESETS[btn.dataset.preset!]
      if (!p) return
      cpPrimary.value = p.primary
      cpText.value    = p.text
      cpBg.value      = p.bg
      cpMuted.value   = p.muted
      syncPicker()
    })
  })

  document.getElementById('cp-apply')!.addEventListener('click', () => {
    const colors = { primary: cpPrimary.value, text: cpText.value, bg: cpBg.value, muted: cpMuted.value }
    localStorage.setItem(CUSTOM_KEY, JSON.stringify(colors))
    localStorage.setItem(THEME_KEY, 'customizable')
    syncThemeButtons('customizable')
    S.reapply()
    persistUser({ theme: 'customizable', customColors: colors })
  })

  document.getElementById('cp-cancel')!.addEventListener('click', () => {
    setTheme(prevTheme)
  })

  // ── Font Picker ──────────────────────────────────────────────────────────────

  const fontSelect = document.getElementById('settings-font-select') as HTMLSelectElement
  fontSelect.value = localStorage.getItem('site-font') || ''

  function syncSelectFont() {
    const opt = fontSelect.options[fontSelect.selectedIndex]
    fontSelect.style.fontFamily = opt?.style.fontFamily || 'ProductSans'
  }
  syncSelectFont()

  fontSelect.addEventListener('change', () => {
    const val = fontSelect.value
    if (val) localStorage.setItem('site-font', val)
    else localStorage.removeItem('site-font')
    S.reapply()
    syncSelectFont()
    persistUser({ font: val || '' })
  })

  // ── Language Switcher ────────────────────────────────────────────────────────

  const LANG_KEY = 'site-lang'

  function syncLangButtons(lang: string) {
    document.querySelectorAll<HTMLButtonElement>('.settings-lang__btn').forEach(btn => {
      btn.classList.toggle('settings-lang__btn--active', btn.dataset.lang === lang)
    })
  }

  syncLangButtons(localStorage.getItem(LANG_KEY) || S.detectSystemLang())

  document.querySelectorAll<HTMLButtonElement>('.settings-lang__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang!
      localStorage.setItem(LANG_KEY, lang)
      syncLangButtons(lang)
      S.reapply()
      persistUser({ lang })
    })
  })

  // ── UI refresh (after cloud load or reset) ────────────────────────────────────

  function refreshControls() {
    const theme = localStorage.getItem(THEME_KEY) || DEFAULT_THEME
    syncThemeButtons(theme)
    if (theme !== 'customizable') prevTheme = theme
    if (theme === 'customizable') loadPickerValues()
    fontSelect.value = localStorage.getItem('site-font') || ''
    syncSelectFont()
    syncLangButtons(localStorage.getItem(LANG_KEY) || S.detectSystemLang())
  }

  // ── Web broadcast banner + countdown ──────────────────────────────────────────

  const webNote  = document.getElementById('settings-webnote')   as HTMLElement
  const webTimer = document.getElementById('settings-web-timer') as HTMLElement
  let webTimerId: ReturnType<typeof setInterval> | null = null

  function updateWebBanner() {
    const web = S.readWeb()
    const active = S.broadcastEligible(web)
    webNote.hidden = !active
    if (webTimerId) { clearInterval(webTimerId); webTimerId = null }
    if (!active) return
    const appliedAt = web.broadcast.appliedAt
    const tick = () => {
      const remaining = appliedAt + S.BROADCAST_TTL - Date.now()
      webTimer.textContent = S.fmtCountdown(remaining)
      if (remaining <= 0) {
        if (webTimerId) { clearInterval(webTimerId); webTimerId = null }
        updateWebBanner()
        S.reapply()
      }
    }
    tick()
    webTimerId = setInterval(tick, 1000)
  }

  updateWebBanner()
  S.listenWeb(() => { updateWebBanner(); S.reapply() })

  // ── Reset to default ──────────────────────────────────────────────────────────

  document.getElementById('settings-reset')!.addEventListener('click', () => {
    localStorage.removeItem(THEME_KEY)
    localStorage.removeItem(CUSTOM_KEY)
    localStorage.removeItem('site-font')
    localStorage.removeItem(LANG_KEY)
    S.optOutOfBroadcast()
    S.reapply()
    refreshControls()
    updateWebBanner()
    persistUser({ theme: '', customColors: null, font: '', lang: '' })
  })

  // ── Account (save preferences to the cloud, any Google account) ───────────────

  const accSignedout = document.getElementById('account-state-signedout') as HTMLElement
  const accSignedin  = document.getElementById('account-state-signedin')  as HTMLElement
  const accAvatar    = document.getElementById('account-avatar')          as HTMLImageElement
  const accName      = document.getElementById('account-name')            as HTMLElement

  ;(async () => {
    let auth: any
    try {
      auth = await import('../lib/core/Auth.js')
    } catch (e) {
      console.error('Settings: auth unavailable, local settings still work:', e)
      return
    }
    document.getElementById('account-signin-btn')!.addEventListener('click', () => {
      auth.signIn().catch(console.error)
    })
    document.getElementById('account-signout-btn')!.addEventListener('click', () => {
      auth.signOut().catch(console.error)
    })
    auth.onAuthChange(async (user: any) => {
      if (!user) {
        uid = null
        accSignedout.hidden = false
        accSignedin.hidden  = true
        return
      }
      uid = user.uid
      accAvatar.src = user.photoURL || ''
      accName.textContent = user.displayName || user.email || ''
      accSignedout.hidden = true
      accSignedin.hidden  = false
      try {
        const us: any = await S.getUserSettings(uid)
        if (us) {
          if (us.theme)        localStorage.setItem(THEME_KEY, us.theme)
          if (us.customColors) localStorage.setItem(CUSTOM_KEY, JSON.stringify(us.customColors))
          if (us.font)         localStorage.setItem('site-font', us.font)
          if (us.lang)         localStorage.setItem(LANG_KEY, us.lang)
          S.reapply()
          refreshControls()
        }
      } catch (e) { console.error(e) }
    })
  })()
</script>
