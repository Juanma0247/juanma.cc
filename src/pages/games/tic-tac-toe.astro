---
import GameLayout from '../../layouts/GameLayout.astro'
---

<GameLayout slug="tic-tac-toe">
  <h2 class="ttt-status" id="j1t1" data-i18n="games.tictactoe.subtitle">Tic-Tac-Toe</h2>
  <div class="ttt-board">
    <table class="ttt-table">
      <tr>
        <td class="ttt-hline"><input id="j1i1" class="ttt-cell" placeholder=" " /></td>
        <td class="ttt-hline ttt-vline"><input id="j1i2" class="ttt-cell" placeholder=" " /></td>
        <td class="ttt-hline"><input id="j1i3" class="ttt-cell" placeholder=" " /></td>
      </tr>
      <tr>
        <td class="ttt-hline"><input id="j1i4" class="ttt-cell" placeholder=" " /></td>
        <td class="ttt-hline ttt-vline"><input id="j1i5" class="ttt-cell" placeholder=" " /></td>
        <td class="ttt-hline"><input id="j1i6" class="ttt-cell" placeholder=" " /></td>
      </tr>
      <tr>
        <td><input id="j1i7" class="ttt-cell" placeholder=" " /></td>
        <td class="ttt-vline"><input id="j1i8" class="ttt-cell" placeholder=" " /></td>
        <td><input id="j1i9" class="ttt-cell" placeholder=" " /></td>
      </tr>
    </table>
  </div>
  <span id="j1auxTurn" style="display:none">0</span>
  <div id="j1contButtons">
    <button id="j1b1" data-i18n="games.tictactoe.restart">Restart</button>
  </div>
  <div class="space-bottom"></div>
</GameLayout>

<style is:global>@import '../../styles/sections/games.css';</style>

<script type="module" is:inline>
  import TicTacToe from '/js/lib/TicTacToe.js'
  const p = new TicTacToe(); p.main()
</script>
