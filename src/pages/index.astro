        <img src="/img/juanma/juanma_basilica_manizales.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_mountaind.jpeg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_river.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_ruiz.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_ruiz_background.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_ruiz_road.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_ruiz_road_bottom.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_ruiz_somg.jpg" alt="Juan Manuel" />
        <img src="/img/juanma/juanma_sit.jpg" alt="Juan Manuel" />
