          <span class="skill-tag"><img src="/img/git.svg" alt="Git" /><span>Git</span><span class="skill-level">20%</span></span>
          <span class="skill-tag"><img src="/img/gsap.svg" alt="GSAP" /><span>GSAP</span><span class="skill-level">60%</span></span>
