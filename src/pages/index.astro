---
import MainLayout from '../layouts/MainLayout.astro'
import { cld } from '../lib/core/cld'

const portraits = [
  'juanma_campo.jpg',
  'juanma_cascada_escondida.jpg',
  'juanma_cascada_rapel.jpg',
  'juanma_cascada_romeral.jpg',
  'juanma_mountaind.jpeg',
  'juanma_river.jpg',
  'juanma_rocas.jpg',
  'juanma_ruiz_background.jpg',
  'juanma_ruiz_road.jpg',
  'juanma_ruiz_somg.jpg',
  'juanma_sobre_arbol.jpg',
]
---

<MainLayout title="" navTitle="juanma.cc">
  <div class="home">

    <section class="hero">
      <div class="hero-text">
        <h1 class="hero-name">Juan Manuel <span class="hero-accent">Diaz Gomez</span></h1>
        <p class="hero-tagline" data-i18n="home.tagline">Computer Scientist · Math Enthusiast · UX/UI Designer · Full-Stack Developer · Hiker/Marathoner · Seasoned Minecraft Technician</p>
        <p class="hero-bio" data-i18n="home.bio">Hi, I'm <strong>Juanma</strong>. I come from <a class="geo" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=1.4777072123416435,-77.01902130581522" data-map="https://maps.google.com/maps?q=1.4777072123416435,-77.01902130581522&z=13&output=embed"><svg class="geo-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span class="geo-name">Las Mesas, Nariño</span><span class="geo-pop"></span></a> and now live in <a class="geo" target="_blank" rel="noopener" href="https://maps.app.goo.gl/YkSYszNc6iNqPaTS6" data-map="https://maps.google.com/maps?q=5.068173,-75.517339&z=13&output=embed"><svg class="geo-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span class="geo-name">Manizales, Caldas</span><span class="geo-pop"></span></a>, where I study. I'm a <a class="geo geo--plain" target="_blank" rel="noopener" href="https://betowa.sena.edu.co/oferta/analisis-y-desarrollo-de-software?search=Analisis+y+dise%C3%B1o+de&programId=136456&modality=V&level=6"><span class="geo-name">SENA</span></a> graduate in Information Systems Analysis and Design, and I'm now studying <a class="geo geo--plain" target="_blank" rel="noopener" href="https://fcen.unal.edu.co/index.php?id=509">Computer Science</a> at <a class="geo" target="_blank" rel="noopener" href="https://www.google.com/maps/place/Universidad+Nacional+de+Colombia+Sede+Manizales+-+Campus+La+Nubia/@5.0290382,-75.4724777,281m/data=!3m1!1e3!4m6!3m5!1s0x8e4765af7f225e41:0x668b66fb520b8cd3!8m2!3d5.0290643!4d-75.4728384!16s%2Fg%2F1tfgf8vx?entry=ttu" data-map="https://maps.google.com/maps?q=5.0290643,-75.4728384&z=16&output=embed"><svg class="geo-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span class="geo-name">UNAL Manizales</span><span class="geo-pop"></span></a>. I've spent six years in software development, and lately I've been broadening my knowledge with computer science — I love staying on the cutting edge. My way of working applies the scientific method to software engineering: really understand the problem, acquire the right knowledge and tools, design correct, reproducible and lasting solutions, then ship them, improving with constant feedback. Here you'll find a personal repository that gathers and sums up part of my work.</p>
        <div class="quick-access">
          <a href="/projects" class="quick-card">
            <i data-feather="folder"></i>
            <span data-i18n="home.quickProjects">Projects</span>
          </a>
          <a href="/scripts" class="quick-card">
            <i data-feather="code"></i>
            <span data-i18n="home.quickCodes">Codes</span>
          </a>
          <a href="/contact" class="quick-card">
            <i data-feather="message-circle"></i>
            <span data-i18n="nav.contact">Contact</span>
          </a>
        </div>
      </div>
      <div class="hero-portrait-reel">
        {portraits.map(p => <img src={cld(`/img/juanma/${p}`)} alt="Juan Manuel" />)}
      </div>
    </section>

    <section class="skills-section">
      <h2 class="section-label" data-i18n="home.skillsTitle">Areas &amp; skills</h2>
      <div class="areas-grid">
        <article class="area">
          <h3 class="area__title" data-i18n="home.area1Title">Computer Science</h3>
          <p class="area__desc" data-i18n="home.area1Desc">The core of everything I do. I think in algorithms, data structures and complexity, and I'm fascinated by the theory of computation (automata and Turing machines), logic and the discrete math behind it all — a lifelong math lover.</p>
        </article>
        <article class="area">
          <h3 class="area__title" data-i18n="home.area2Title">Full-stack web development</h3>
          <p class="area__desc" data-i18n="home.area2Desc">I build complete sites and apps, front to back. On the front, React, Next.js and Astro alongside HTML, CSS and JavaScript/TypeScript; on the server, Node.js, Express and FastAPI. Styling with Tailwind and motion with GSAP.</p>
        </article>
        <article class="area">
          <h3 class="area__title" data-i18n="home.area3Title">Languages &amp; software</h3>
          <p class="area__desc" data-i18n="home.area3Desc">I move across paradigms and languages: Java and Kotlin for robust apps, TypeScript for type-safe code end to end, and Python as a Swiss-army knife for scripting, automation and quick prototypes. I version everything with Git.</p>
        </article>
        <article class="area">
          <h3 class="area__title" data-i18n="home.area4Title">Data, math &amp; machine learning</h3>
          <p class="area__desc" data-i18n="home.area4Desc">I love probability and statistics, data analysis and machine learning: I model, experiment and visualize results, and handle data with PostgreSQL, MySQL, Supabase and Firestore.</p>
        </article>
        <article class="area">
          <h3 class="area__title" data-i18n="home.area5Title">Design, UX/UI &amp; multimedia</h3>
          <p class="area__desc" data-i18n="home.area5Desc">I also come from the visual world: graphic design and UX/UI with Illustrator, Photoshop, Adobe XD and InDesign; video editing with Premiere, 3D with Blender, streaming and capture with OBS, and technical writing with LaTeX.</p>
        </article>
        <article class="area">
          <h3 class="area__title" data-i18n="home.area6Title">Cloud, deployment &amp; AI</h3>
          <p class="area__desc" data-i18n="home.area6Desc">I take apps to production: containers with Docker, continuous deployment on Firebase App Hosting, media on Cloudinary and managed databases with Supabase. And when it adds value, I wire in AI models like OpenAI's.</p>
        </article>
      </div>
    </section>

  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image gallery">
    <button class="lightbox__close" id="lb-close" aria-label="Close">&times;</button>
    <button class="lightbox__nav lightbox__nav--prev" id="lb-prev" aria-label="Previous">&#8249;</button>
    <div class="lightbox__stage">
      <img class="lightbox__img" id="lb-img" src="" alt="Juan Manuel" />
    </div>
    <button class="lightbox__nav lightbox__nav--next" id="lb-next" aria-label="Next">&#8250;</button>
    <div class="lightbox__counter" id="lb-counter"></div>
  </div>
</MainLayout>

<style>
  @import '../styles/sections/home.css';
</style>

<script>
  const reel = document.querySelector('.hero-portrait-reel') as HTMLElement;
  const imgs = [...document.querySelectorAll('.hero-portrait-reel img')] as HTMLImageElement[];
  const displayMs = [2600, 1700, 3100, 1500, 2900, 1300, 2400, 3300, 1800, 2200];
  const CLOSE_MS = 380;
  const BLINK_MS = 90;
  let current = 0;
  let reelTimer: ReturnType<typeof setTimeout> | undefined;

  function scheduleNext() {
    reelTimer = setTimeout(next, displayMs[current % displayMs.length]);
  }

  function next() {
    const prev = current;
    current = (current + 1) % imgs.length;

    imgs[prev].classList.remove('active');

    setTimeout(() => {
      imgs[current].classList.add('active');
      scheduleNext();
    }, CLOSE_MS + BLINK_MS);
  }

  imgs[0].classList.add('active');
  scheduleNext();

  // ── Lightbox (fullscreen image slider) ──────────────────────────────────────
  const lb        = document.getElementById('lightbox') as HTMLElement;
  // Move it out of `.contenedor` (which has its own stacking context) so the
  // overlay sits above the fixed navbar.
  document.body.appendChild(lb);
  const lbImg     = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter') as HTMLElement;
  const srcs      = imgs.map(img => img.getAttribute('src') ?? '');
  let lbIndex = 0;

  function renderLb() {
    lbImg.src = srcs[lbIndex];
    lbCounter.textContent = `${lbIndex + 1} / ${srcs.length}`;
  }

  function openLb(i: number) {
    lbIndex = i;
    renderLb();
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (reelTimer) clearTimeout(reelTimer);
  }

  function closeLb() {
    lb.classList.remove('is-open');
    document.body.style.overflow = '';
    scheduleNext();
  }

  function navLb(dir: number) {
    lbIndex = (lbIndex + dir + srcs.length) % srcs.length;
    renderLb();
  }

  // Open at the image currently visible in the reel.
  reel.style.cursor = 'zoom-in';
  reel.addEventListener('click', () => openLb(current));

  document.getElementById('lb-next')!.addEventListener('click', e => { e.stopPropagation(); navLb(1); });
  document.getElementById('lb-prev')!.addEventListener('click', e => { e.stopPropagation(); navLb(-1); });
  document.getElementById('lb-close')!.addEventListener('click', closeLb);
  lb.addEventListener('click', e => { if (e.target === lb || e.target === lbImg.parentElement) closeLb(); });

  document.addEventListener('keydown', e => {
    if (!lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowRight') navLb(1);
    else if (e.key === 'ArrowLeft') navLb(-1);
  });

  // Swipe on touch devices.
  let touchStartX: number | null = null;
  lb.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', e => {
    if (touchStartX === null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 45) navLb(dx < 0 ? 1 : -1);
    touchStartX = null;
  });

  // Preload the Google Maps minimaps as soon as the page loads, so the popover
  // shows instantly on hover instead of loading the iframe on demand.
  function preloadGeoMaps() {
    document.querySelectorAll<HTMLElement>('.geo').forEach(geo => {
      const pop = geo.querySelector<HTMLElement>('.geo-pop');
      if (!pop || pop.dataset.loaded || !geo.dataset.map) return;
      const iframe = document.createElement('iframe');
      iframe.src = geo.dataset.map;
      iframe.loading = 'eager';
      iframe.title = geo.querySelector('.geo-name')?.textContent ?? 'Map';
      pop.appendChild(iframe);
      pop.dataset.loaded = '1';
    });
  }

  // The bio (with the .geo chips) is re-rendered by i18n on language change,
  // which wipes the preloaded iframes — re-run the preload after each change.
  const heroBio = document.querySelector('.hero-bio');
  if (heroBio) new MutationObserver(() => preloadGeoMaps()).observe(heroBio, { childList: true, subtree: true });
  preloadGeoMaps();
</script>
