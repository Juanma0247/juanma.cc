          <span class="skill-tag"><img src="/img/languages/javascript.svg" alt="JavaScript" /><span>JavaScript</span><span class="skill-level">65%</span></span>
          <span class="skill-tag"><img src="/img/languages/kotlin.svg" alt="Kotlin" /><span>Kotlin</span><span class="skill-level">80%</span></span>
