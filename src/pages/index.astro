          <span class="skill-tag"><img src="/img/css.svg" alt="CSS" /><span>CSS</span><span class="skill-level">85%</span></span>
          <span class="skill-tag"><img src="/img/firebase.svg" alt="Firebase" /><span>Firebase</span><span class="skill-level">80%</span></span>
