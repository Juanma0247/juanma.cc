        </div>
      </div>
      <div class="skill-group">
        <p class="skill-group-title" data-i18n="home.designTitle">Design</p>
        <div class="skills-row">
          <span class="skill-tag"><img src="/img/illustrator.svg" alt="Illustrator" /><span>Illustrator</span><span class="skill-level">80%</span></span>
          <span class="skill-tag"><img src="/img/photoshop.svg" alt="Photoshop" /><span>Photoshop</span><span class="skill-level">75%</span></span>
          <span class="skill-tag"><img src="/img/xd.svg" alt="XD" /><span>Adobe XD</span><span class="skill-level">90%</span></span>
          <span class="skill-tag"><img src="/img/premiere.svg" alt="Premiere" /><span>Premiere</span><span class="skill-level">65%</span></span>
          <span class="skill-tag"><img src="/img/indesign.svg" alt="InDesign" /><span>InDesign</span><span class="skill-level">75%</span></span>
          <span class="skill-tag"><img src="/img/blender.svg" alt="Blender" /><span>Blender</span><span class="skill-level">30%</span></span>
          <span class="skill-tag"><img src="/img/obs.svg" alt="OBS" /><span>OBS</span><span class="skill-level">80%</span></span>
        </div>
      </div>
    </section>

    <section class="built-section">
      <h2 class="section-label" data-i18n="home.builtTitle">What I've built</h2>
      <div class="built-grid">
        <div class="built-card">
          <div class="built-card-header">
            <h3 class="built-card-name" data-i18n="home.builtCard1Title">Icfes para disciplinados</h3>
            <a class="built-card-link" href="https://icfesparadisciplinados.github.io/pages/login.html" target="_blank">
              <i data-feather="external-link"></i>
              <span data-i18n="home.goToSite">Go to site</span>
            </a>
          </div>
          <p data-i18n="home.builtCard1Desc">A platform to share study material for the Colombian Saber 11 exam. Access with document: <strong>0123456789</strong> / password: <strong>ABCD</strong></p>
        </div>
        <div class="built-card">
          <div class="built-card-header">
            <h3 class="built-card-name" data-i18n="home.builtCard2Title">Catálogo boutique Arcur</h3>
            <a class="built-card-link" href="https://boutiquearcurcolombia.web.app/" target="_blank">
              <i data-feather="external-link"></i>
              <span data-i18n="home.goToSite">Go to site</span>
            </a>
          </div>
          <p data-i18n="home.builtCard2Desc">Product catalog for Colombian clothing brand Arcur, with a hidden admin CRUD system.</p>
        </div>
      </div>
    </section>

  </div>
</MainLayout>

<style>
  @import '../styles/sections/home.css';
</style>

<script>
  const imgs = [...document.querySelectorAll('.hero-portrait-reel img')] as HTMLImageElement[];
  const displayMs = [2600, 1700, 3100, 1500, 2900, 1300, 2400, 3300, 1800, 2200];
  const CLOSE_MS = 380;
  const BLINK_MS = 90;
  let current = 0;

  function next() {
    const prev = current;
    current = (current + 1) % imgs.length;

    imgs[prev].classList.remove('active');

    setTimeout(() => {
      imgs[current].classList.add('active');
      setTimeout(next, displayMs[current]);
    }, CLOSE_MS + BLINK_MS);
  }

  imgs[0].classList.add('active');
  setTimeout(next, displayMs[0]);

  // Lazy-load the Google Maps minimap only when hovering a location chip.
  // Delegated on document so it survives i18n re-renders of the bio.
  document.addEventListener('mouseover', e => {
    const geo = (e.target as Element).closest<HTMLElement>('.geo');
    if (!geo) return;
    const pop = geo.querySelector<HTMLElement>('.geo-pop');
    if (!pop || pop.dataset.loaded || !geo.dataset.map) return;
    const iframe = document.createElement('iframe');
    iframe.src = geo.dataset.map;
    iframe.loading = 'lazy';
    iframe.title = geo.querySelector('.geo-name')?.textContent ?? 'Map';
    pop.appendChild(iframe);
    pop.dataset.loaded = '1';
  });
</script>
