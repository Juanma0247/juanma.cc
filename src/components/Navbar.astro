---
import { SECTIONS } from '../data/nav'
import type { NavSection } from '../data/nav'

interface Props {
  navTitle?: string
  section?: string
  icon?: string
  titleHref?: string
  titleKey?: string
}

const {
  navTitle = 'Juanma',
  section = '',
  icon = '/img/favicon.svg',
  titleHref = '',
  titleKey = '',
} = Astro.props

const pathname = Astro.url.pathname

function getActiveSection(sections: NavSection[], path: string): NavSection | undefined {
  if (path === '/') return sections.find(s => s.href === '/')
  return sections.find(s => s.href !== '/' && path.startsWith(s.href))
}

const activeSection = getActiveSection(SECTIONS, pathname)

// A page is a "subpage" once it declares a `titleHref` back to its parent
// section while not being the home page itself (home may set its own
// titleHref for unrelated reasons). Section-root pages (Projects, Scripts,
// Space…) don't set titleHref, so they fall back to home.
const isSubpage = pathname !== '/' && !!titleHref
const showLogo = !isSubpage
const showBackBtn = pathname !== '/'
const backHref = isSubpage ? titleHref : '/'
const backIcon = isSubpage ? 'arrow-left' : 'home'
const backLabelKey = isSubpage ? 'a11y.goBack' : 'a11y.goHome'
const titleLinkHref = titleHref || '/'
---

<nav id="topbar" class="topbar" aria-label="Main navigation" data-i18n-aria-label="a11y.mainNav">

  {showBackBtn && (
    <a class="topbar__home-btn" href={backHref} aria-label={backIcon === 'home' ? 'Go home' : 'Go back'} data-i18n-aria-label={backLabelKey}>
      <i data-feather={backIcon}></i>
    </a>
  )}

  <div class="topbar__identity">
    {showLogo && (
      <a class="topbar__logo-link" href="/" aria-label="Go home" data-i18n-aria-label="a11y.goHome">
        <img class="topbar__logo" src={icon} alt="" aria-hidden="true" />
      </a>
    )}
    <div class="topbar__identity-text">
      <a class="topbar__title topbar__title--link" href={titleLinkHref} data-i18n={titleKey || undefined}>{navTitle}</a>
      <div class="topbar__meta">
        {section && <img class="topbar__icon" src={icon} alt="" aria-hidden="true" />}
        {section && <span class="topbar__section" data-i18n={`sections.${section.toLowerCase()}`}>{section}</span>}
      </div>
    </div>
  </div>

  <button class="topbar__menu-toggle" id="topbar-menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-i18n-aria-label="a11y.toggleMenu">
    <svg class="topbar__menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="5" r="1.9" />
      <circle cx="12" cy="12" r="1.9" />
      <circle cx="12" cy="19" r="1.9" />
    </svg>
  </button>

  <div class="topbar__nav" id="topbar-nav">
    {SECTIONS.map(s => (
      <a
        href={s.href}
        class={`topbar__navitem${s === activeSection ? ' topbar__navitem--active' : ''}`}
        aria-current={s === activeSection ? 'page' : undefined}
      >
        <i data-feather={s.featherIcon}></i>
        <span data-i18n={`nav.${s.id}`}>{s.label}</span>
      </a>
    ))}
  </div>

</nav>

<script>
  const toggleBtn = document.getElementById('topbar-menu-toggle') as HTMLButtonElement | null
  const nav = document.getElementById('topbar-nav') as HTMLElement | null

  if (toggleBtn && nav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('topbar__nav--open')
      toggleBtn.setAttribute('aria-expanded', String(isOpen))
    })

    nav.querySelectorAll('.topbar__navitem').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('topbar__nav--open')
        toggleBtn.setAttribute('aria-expanded', 'false')
      })
    })
  }
</script>
