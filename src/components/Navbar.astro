---
import { SECTIONS } from '../data/nav'
import type { NavSection } from '../data/nav'
import { tagKey } from '../data/i18n/keys'

interface Props {
  navTitle?: string
  section?: string
  labels?: string[]
  icon?: string
  titleHref?: string
  titleKey?: string
}

const {
  navTitle = 'Juanma',
  section = '',
  labels = [],
  icon = '/img/favicon.svg',
  titleHref = '',
  titleKey = '',
} = Astro.props

const pathname = Astro.url.pathname

function getActiveSection(sections: NavSection[], path: string): NavSection | undefined {
  if (path === '/') return sections.find(s => s.href === '/')
  return sections.find(s => s.href !== '/' && path.startsWith(s.href))
}

const activeSection = getActiveSection(SECTIONS, pathname)
const displayLabels = labels.slice(0, 3)
---

<nav id="topbar" class="topbar" aria-label="Main navigation" data-i18n-aria-label="a11y.mainNav">

  <div class="topbar__identity">
    {titleHref
      ? <a class="topbar__title topbar__title--link" href={titleHref} data-i18n={titleKey || undefined}>{navTitle}</a>
      : <p class="topbar__title" data-i18n={titleKey || undefined}>{navTitle}</p>}
    <div class="topbar__meta">
      {(displayLabels.length > 0 || section) && (
        <img class="topbar__icon" src={icon} alt="" aria-hidden="true" />
      )}
      {displayLabels.length > 0 && (
        <span
          class="topbar__label"
          id="topbar-label"
          data-labels={JSON.stringify(displayLabels)}
          data-label-keys={JSON.stringify(displayLabels.map(l => `tags.${tagKey(l)}`))}
        >
          {displayLabels[0]}
        </span>
      )}
      {section && <span class="topbar__section" data-i18n={`sections.${section.toLowerCase()}`}>{section}</span>}
    </div>
  </div>

  <button class="topbar__menu-toggle" id="topbar-menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-i18n-aria-label="a11y.toggleMenu">
    <svg class="topbar__menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="5" r="1.9" />
      <circle cx="12" cy="12" r="1.9" />
      <circle cx="12" cy="19" r="1.9" />
    </svg>
  </button>

  <div class="topbar__nav" id="topbar-nav">
    {SECTIONS.map(s => (
      <a
        href={s.href}
        class={`topbar__navitem${s === activeSection ? ' topbar__navitem--active' : ''}`}
        aria-current={s === activeSection ? 'page' : undefined}
      >
        <i data-feather={s.featherIcon}></i>
        <span data-i18n={`nav.${s.id}`}>{s.label}</span>
      </a>
    ))}
  </div>

</nav>

<script>
  const labelEl = document.getElementById('topbar-label') as HTMLElement | null
  if (labelEl) {
    const allLabels: string[] = JSON.parse(labelEl.dataset.labels || '[]')
    const labelKeys: string[] = JSON.parse(labelEl.dataset.labelKeys || '[]')
    // Resolve each rotating label against the current language, falling back to
    // the English source when a tag has no translation.
    const resolve = (i: number) => {
      const get = (window as any).i18nGet
      return get ? get(labelKeys[i], allLabels[i]) : allLabels[i]
    }
    let idx = 0
    const paint = () => { labelEl.textContent = resolve(idx) }
    paint()
    if (allLabels.length > 1) {
      setInterval(() => {
        labelEl.style.opacity = '0'
        setTimeout(() => {
          idx = (idx + 1) % allLabels.length
          paint()
          labelEl.style.opacity = '1'
        }, 300)
      }, 2500)
    }
    window.addEventListener('langchanged', paint)
  }

  const toggleBtn = document.getElementById('topbar-menu-toggle') as HTMLButtonElement | null
  const nav = document.getElementById('topbar-nav') as HTMLElement | null

  if (toggleBtn && nav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('topbar__nav--open')
      toggleBtn.setAttribute('aria-expanded', String(isOpen))
    })

    nav.querySelectorAll('.topbar__navitem').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('topbar__nav--open')
        toggleBtn.setAttribute('aria-expanded', 'false')
      })
    })
  }
</script>
