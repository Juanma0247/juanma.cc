---
import { SECTIONS } from '../data/nav'
import type { NavSection } from '../data/nav'

interface Props {
  navTitle?: string
  section?: string
  labels?: string[]
  icon?: string
}

const {
  navTitle = 'Juanma',
  section = '',
  labels = [],
  icon = '/img/favicon.svg',
} = Astro.props

const pathname = Astro.url.pathname

function getActiveSection(sections: NavSection[], path: string): NavSection | undefined {
  if (path === '/') return sections.find(s => s.href === '/')
  return sections.find(s => s.href !== '/' && path.startsWith(s.href))
}

const activeSection = getActiveSection(SECTIONS, pathname)
const isSettings = pathname === '/settings'
const displayLabels = labels.slice(0, 3)
---

<nav id="topbar" class="topbar" aria-label="Main navigation">

  <div class="topbar__identity">
    <p class="topbar__title">{navTitle}</p>
    <div class="topbar__meta">
      <img class="topbar__icon" src={icon} alt="" aria-hidden="true" />
      {displayLabels.length > 0 && (
        <span class="topbar__label" id="topbar-label" data-labels={JSON.stringify(displayLabels)}>
          {displayLabels[0]}
        </span>
      )}
      {section && <span class="topbar__section" data-i18n={`sections.${section.toLowerCase()}`}>{section}</span>}
    </div>
  </div>

  <button class="topbar__menu-toggle" id="topbar-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
    <i data-feather="more-vertical"></i>
  </button>

  <div class="topbar__nav" id="topbar-nav">
    {SECTIONS.map(s => (
      <a
        href={s.href}
        class={`topbar__navitem${s === activeSection ? ' topbar__navitem--active' : ''}`}
        aria-current={s === activeSection ? 'page' : undefined}
      >
        <i data-feather={s.featherIcon}></i>
        <span data-i18n={`nav.${s.id}`}>{s.label}</span>
      </a>
    ))}
    <a
      href="/settings"
      class={`topbar__navitem${isSettings ? ' topbar__navitem--active' : ''}`}
      aria-current={isSettings ? 'page' : undefined}
    >
      <i data-feather="settings"></i>
      <span data-i18n="nav.settings">Settings</span>
    </a>
  </div>

</nav>

<script>
  const labelEl = document.getElementById('topbar-label') as HTMLElement | null
  if (labelEl) {
    const allLabels: string[] = JSON.parse(labelEl.dataset.labels || '[]')
    if (allLabels.length > 1) {
      let idx = 0
      setInterval(() => {
        labelEl.style.opacity = '0'
        setTimeout(() => {
          idx = (idx + 1) % allLabels.length
          labelEl.textContent = allLabels[idx]
          labelEl.style.opacity = '1'
        }, 300)
      }, 2500)
    }
  }

  const toggleBtn = document.getElementById('topbar-menu-toggle') as HTMLButtonElement | null
  const nav = document.getElementById('topbar-nav') as HTMLElement | null

  if (toggleBtn && nav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('topbar__nav--open')
      toggleBtn.setAttribute('aria-expanded', String(isOpen))
    })

    nav.querySelectorAll('.topbar__navitem').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('topbar__nav--open')
        toggleBtn.setAttribute('aria-expanded', 'false')
      })
    })
  }
</script>
