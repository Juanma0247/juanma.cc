# Firebase (public client config)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudinary — cloud name is public and is all the app needs to DELIVER images.
# Leave empty to keep serving /img/* locally from the app host.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Used ONLY by `npm run cloudinary:upload` to push local images to Cloudinary.
# These are secrets — never commit them and never add them to apphosting.yaml.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional base folder; must match FOLDER in src/lib/core/cld.ts (default "mypage").
CLOUDINARY_FOLDER=mypage
